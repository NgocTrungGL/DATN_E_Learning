<% content_for :full_width, "true" %>
<div class="cart-wrapper">
  <div class="cart-header">
    <h1 class="cart-header__title"><i class="bi bi-cart3"></i> Your cart</h1>
  </div>

  <% if @items.any? %>
    <div class="cart-layout">
      <%# Main List %>
      <div class="cart-main">
        <ul class="cart-list">
          <% @items.each do |item| %>
            <li class="cart-item">
              <div class="cart-item__thumb">
                <% if item.course.thumbnail_url.present? %>
                  <img src="<%= item.course.thumbnail_url %>" alt="<%= item.course.title %>">
                <% else %>
                  <i class="bi bi-image fs-4"></i>
                <% end %>
              </div>

              <div class="cart-item__details">
                <%= link_to item.course.title, course_path(item.course), class: "cart-item__title" %>
                <p class="cart-item__instructor">Instructor: <%= item.course.creator&.name || "Admin" %></p>
                <div class="cart-item__rating">
                  <% avg = item.course.reviews.average(:rating).to_f.round(1) %>
                  <% if avg > 0 %>
                    <span class="cart-item__stars">
                      <% avg.floor.times do %><i class="bi bi-star-fill"></i><% end %>
                      <% if avg - avg.floor >= 0.5 %><i class="bi bi-star-half"></i><% end %>
                      <% (5 - avg.ceil).times do %><i class="bi bi-star"></i><% end %>
                    </span>
                    <span class="cart-item__rating-text"><%= avg %></span>
                  <% else %>
                    <span class="cart-item__rating-text" style="color: #94a3b8;">New</span>
                  <% end %>
                </div>
              </div>

              <div class="cart-item__actions">
                <div class="cart-item__buttons-group">
                  <%= button_to "Remove", cart_item_path(item), method: :delete, class: "cart-item__text-btn cart-item__text-btn--danger", title: "Remove this course" %>
                  <%= button_to "Move to wishlist", move_to_wishlist_cart_item_path(item), method: :post, class: "cart-item__text-btn", title: "Move to wishlist" %>
                </div>

                <div class="cart-item__price-wrap">
                  <%# Get coupon from session for this course %>
                  <% course_id_str = item.course.id.to_s %>
                  <% session_coupon_code = session[:course_coupons]&.dig(course_id_str) %>
                  <% session_coupon = session_coupon_code.present? ? Coupon.find_by(code: session_coupon_code) : nil %>
                  <% session_coupon = nil if session_coupon && !session_coupon.active_and_current? %>

                  <%# Calculate discount from both auto and session coupon %>
                  <% auto_discount = item.course.has_discount? ? item.course.price - item.course.discounted_price : 0 %>
                  <% coupon_discount = 0 %>
                  <% if session_coupon && (session_coupon.specific_course? && session_coupon.course_id == item.course.id || session_coupon.global?) %>
                    <% coupon_discount = session_coupon.percentage? ? item.course.price * session_coupon.discount_value / 100.0 : session_coupon.discount_value %>
                  <% end %>
                  <% total_item_discount = auto_discount + coupon_discount %>
                  <% final_item_price = item.course.price - total_item_discount %>

                  <% if total_item_discount > 0 %>
                    <span class="cart-item__current-price" style="color: #10b981; font-weight: 700;">
                      <%= number_to_currency(final_item_price, unit: "VND", precision: 0, format: "%n %u") %>
                    </span>
                    <div class="cart-item__original-price-row">
                      <span class="cart-item__original-price" style="text-decoration: line-through; color: #94a3b8;">
                        <%= number_to_currency(item.course.price, unit: "VND", precision: 0, format: "%n %u") %>
                      </span>
                      <% if item.course.has_discount? %>
                        <span class="cart-item__discount-badge" style="background: #fef2f2; color: #ef4444; border: 1px solid #fca5a5;">
                          <%= item.course.discount_label %>
                        </span>
                      <% elsif session_coupon %>
                        <span class="cart-item__discount-badge" style="background: #fef2f2; color: #ef4444; border: 1px solid #fca5a5;">
                          <i class="bi bi-tag-fill"></i> <%= session_coupon.code %>
                        </span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="cart-item__current-price">
                      <%= number_to_currency(item.course.price, unit: "VND", precision: 0, format: "%n %u") %>
                    </span>
                  <% end %>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      </div>

      <%# Sidebar Summary %>
      <div class="cart-sidebar">
        <div class="cart-summary">
          <h2 class="cart-summary__title">Order summary</h2>

          <%# Promo code section removed - coupons are applied per course on course pages %>

          <%# Calculate total discount from session coupons %>
          <% total_session_discount = 0 %>
          <% @items.each do |item| %>
            <% course_id_str = item.course.id.to_s %>
            <% session_coupon_code = session[:course_coupons]&.dig(course_id_str) %>
            <% session_coupon = session_coupon_code.present? ? Coupon.find_by(code: session_coupon_code) : nil %>
            <% if session_coupon && (session_coupon.specific_course? && session_coupon.course_id == item.course.id || session_coupon.global?) %>
              <% total_session_discount += session_coupon.percentage? ? item.course.price * session_coupon.discount_value / 100.0 : session_coupon.discount_value %>
            <% end %>
          <% end %>

          <%# Total discount = auto discount + session coupon discount %>
          <% total_auto_discount = @items.sum { |item| item.course.has_discount? ? item.course.price - item.course.discounted_price : 0 } %>
          <% total_discount = total_auto_discount + total_session_discount %>
          <% final_total = @cart.total_price - total_discount %>

          <div class="cart-summary__row">
            <span class="label">Subtotal:</span>
            <span class="value"><%= number_to_currency(@cart.total_price, unit: "VND", precision: 0, format: "%n %u") %></span>
          </div>

          <% if total_discount > 0 %>
            <div class="cart-summary__row cart-summary__row--discount">
              <span class="label">Discount:</span>
              <span class="value">- <%= number_to_currency(total_discount, unit: "VND", precision: 0, format: "%n %u") %></span>
            </div>

            <% percentage_saved = ((total_discount.to_f / @cart.total_price) * 100).round %>
            <div class="cart-summary__row">
              <span class="label">Saved:</span>
              <span class="value" style="color: #10b981; background: #d1fae5; padding: 2px 8px; border-radius: 4px; font-size: 0.85rem;"><%= percentage_saved %>%</span>
            </div>
          <% end %>

          <div class="cart-summary__divider"></div>

          <div class="cart-summary__total">
            <span class="label">Total:</span>
            <span class="value"><%= number_to_currency([final_total, 0].max, unit: "VND", precision: 0, format: "%n %u") %></span>
          </div>

          <%= button_to checkout_cart_path, method: :post, data: { turbo: false }, class: "cart-summary__checkout-btn" do %>
            Checkout now
          <% end %>

          <div class="cart-summary__secure">
            <i class="bi bi-shield-lock"></i> Secure checkout via Stripe
          </div>
        </div>
      </div>

      <%= render "courses/recommendations",
                 results: @cart_recommendation_results,
                 kicker: t("recommendations.cart.kicker"),
                 title: t("recommendations.cart.title"),
                 modifier: "cart" %>

      <%# Wishlist Section inside layout so it sits under the main cart %>
      <% if @wishlists.any? %>
        <div class="cart-wishlist">
          <div class="cart-wishlist__header">
            <h3>Recently added to wishlist</h3>
          </div>
          <div class="cart-wishlist__list">
            <% @wishlists.each do |wishlist| %>
              <% course = wishlist.course %>
              <div class="cart-wishlist-item">
                <div class="cart-wishlist-item__thumb">
                  <% if course.thumbnail_url.present? %>
                    <img src="<%= course.thumbnail_url %>" alt="<%= course.title %>">
                  <% else %>
                    <div style="width:100%;height:100%;background:#e2e8f0;display:flex;align-items:center;justify-content:center;">
                      <i class="bi bi-image" style="color:#94a3b8;font-size:1.5rem;"></i>
                    </div>
                  <% end %>
                </div>
                
                <div class="cart-wishlist-item__details">
                  <%= link_to course.title, course_path(course), class: "cart-wishlist-item__title" %>
                  <p class="cart-wishlist-item__meta">By <%= course.creator&.name || "Admin" %></p>
                  
                  <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px; font-size: 0.85rem;">
                    <% if course.reviews.any? %>
                      <strong style="color: #b4690e;"><%= course.reviews.average(:rating).to_f.round(1) %></strong>
                      <i class="bi bi-star-fill" style="color: #f59e0b; font-size: 0.75rem;"></i>
                      <span class="text-muted">(<%= course.reviews.count %> ratings)</span>
                    <% else %>
                      <span class="text-muted">No reviews yet</span>
                    <% end %>
                  </div>
                </div>
                
                <div class="cart-wishlist-item__actions">
                  <div class="cart-wishlist-item__buttons">
                    <%= button_to "Remove", course_toggle_wishlist_path(course), method: :post, class: "cart-wishlist-item__remove-btn" %>
                    <%= button_to "Move to cart", move_wishlist_to_cart_path(course), method: :post, class: "cart-wishlist-item__move-btn" %>
                  </div>
                  
                  <div class="cart-item__price-wrap">
                    <span class="cart-item__current-price" style="font-size: 1.1rem;">
                      <%= number_to_currency(course.discounted_price, unit: "₫", precision: 0, format: "%n %u") %>
                    </span>
                    <% if course.has_discount? %>
                      <div class="cart-item__original-price-row">
                        <span class="cart-item__original-price">
                          <%= number_to_currency(course.price, unit: "₫", precision: 0, format: "%n %u") %>
                        </span>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
      
    </div>
  <% else %>
    <div class="cart-empty">
      <div class="cart-empty__icon">
        <i class="bi bi-cart-x"></i>
      </div>
      <h2 class="cart-empty__title">Your cart is empty</h2>
      <p class="cart-empty__text">Find the right course to level up your skills today.</p>
      <%= link_to "Explore courses", courses_path, class: "cart-empty__btn" %>
    </div>

    <%= render "courses/recommendations",
               results: @cart_recommendation_results,
               kicker: t("recommendations.cart.kicker"),
               title: t("recommendations.cart.title"),
               modifier: "cart-empty" %>

    <% if @wishlists.any? %>
      <div class="cart-wishlist" style="margin-top: 24px;">
        <div class="cart-wishlist__header">
          <h3>Recently added to wishlist</h3>
        </div>
        <div class="cart-wishlist__list">
          <% @wishlists.each do |wishlist| %>
            <% course = wishlist.course %>
            <div class="cart-wishlist-item">
              <div class="cart-wishlist-item__thumb">
                <% if course.thumbnail_url.present? %>
                  <img src="<%= course.thumbnail_url %>" alt="<%= course.title %>">
                <% else %>
                  <div style="width:100%;height:100%;background:#e2e8f0;display:flex;align-items:center;justify-content:center;">
                    <i class="bi bi-image" style="color:#94a3b8;font-size:1.5rem;"></i>
                  </div>
                <% end %>
              </div>
              
              <div class="cart-wishlist-item__details">
                <%= link_to course.title, course_path(course), class: "cart-wishlist-item__title" %>
                <p class="cart-wishlist-item__meta">By <%= course.creator&.name || "Admin" %></p>
              </div>
              
              <div class="cart-wishlist-item__actions">
                <div class="cart-wishlist-item__buttons">
                  <%= button_to "Remove", course_toggle_wishlist_path(course), method: :post, class: "cart-wishlist-item__remove-btn" %>
                  <%= button_to "Move to cart", move_wishlist_to_cart_path(course), method: :post, class: "cart-wishlist-item__move-btn" %>
                </div>
                
                <div class="cart-item__price-wrap">
                  <% if course.has_discount? %>
                    <span class="cart-item__current-price" style="color: #10b981; font-weight: 700; font-size: 1.1rem;">
                      <%= number_to_currency(course.discounted_price, unit: "₫", precision: 0, format: "%n %u") %>
                    </span>
                    <div class="cart-item__original-price-row">
                      <span class="cart-item__original-price" style="text-decoration: line-through; color: #94a3b8;">
                        <%= number_to_currency(course.price, unit: "₫", precision: 0, format: "%n %u") %>
                      </span>
                      <span class="cart-item__discount-badge" style="background: #fef2f2; color: #ef4444; border: 1px solid #fca5a5;">
                        <%= course.discount_label %>
                      </span>
                    </div>
                  <% else %>
                    <span class="cart-item__current-price" style="font-size: 1.1rem;">
                      <%= number_to_currency(course.price, unit: "₫", precision: 0, format: "%n %u") %>
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
