<!DOCTYPE html>
<html>
  <head>
    <title><%= current_user.organization&.name %> | Business Portal</title>
    <%= favicon_link_tag 'favicon.ico' %>
    <%= favicon_link_tag 'favicon.png', type: 'image/png' %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  </head>

  <body class="biz-body">
    <div class="biz-layout">
      <%= render 'layouts/business_sidebar' %>

      <div class="biz-main">
        <header class="biz-topbar">
          <div class="biz-topbar__left">
            <i class="bi bi-building" style="color: #0ea5e9;"></i>
            <h1 class="biz-topbar__title"><%= current_user.organization&.name %></h1>
          </div>
          <div class="biz-topbar__right">
            <div class="biz-user-menu">
              <div class="biz-user-avatar">
                <%= current_user.name[0].upcase %>
              </div>
              <span class="biz-user-name"><%= current_user.name %></span>
              <div class="biz-user-dropdown">
                <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "biz-user-dropdown__item biz-user-dropdown__item--danger" do %>
                  <i class="bi bi-box-arrow-right"></i>
                  Sign out
                <% end %>
              </div>
            </div>
          </div>
        </header>

        <main class="biz-content">
          <%= render 'layouts/flash_messages' %>
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
