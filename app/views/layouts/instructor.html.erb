<!DOCTYPE html>
<html>
  <head>
    <title>Instructor Portal | E-Learning</title>
    <%= favicon_link_tag 'favicon.ico' %>
    <%= favicon_link_tag 'favicon.png', type: 'image/png' %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  </head>

  <body class="layout-instructor">
    <div class="instructor-wrapper">
      <%= render "layouts/instructor_sidebar" %>

      <div class="layout-instructor__main">
        <div class="layout-instructor__topbar">
          <div class="layout-instructor__topbar-left">
            <span class="layout-instructor__topbar-title">Instructor Area</span>
          </div>
          <div class="layout-instructor__topbar-right">
            <a href="<%= root_path %>" class="layout-instructor__topbar-link" target="_blank">
              <i class="bi bi-box-arrow-up-right"></i>
              <span>Homepage</span>
            </a>

            <div class="layout-instructor__user">
              <div class="layout-instructor__user-avatar">
                <%= current_user.name[0].upcase %>
              </div>
              <div class="layout-instructor__user-info">
                <span class="layout-instructor__user-name"><%= current_user.name %></span>
                <span class="layout-instructor__user-role">Instructor</span>
              </div>
              <div class="layout-instructor__user-menu">
                <a href="<%= edit_user_registration_path %>" class="layout-instructor__user-menu-item">
                  <i class="bi bi-person-gear"></i>
                  <span>Account</span>
                </a>
                <%= button_to destroy_user_session_path, method: :delete, class: "layout-instructor__user-menu-item layout-instructor__user-menu-item--danger" do %>
                  <i class="bi bi-box-arrow-right"></i>
                  <span>Sign out</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <div class="layout-instructor__content">
          <% if notice %>
            <div class="inst-alert inst-alert--success">
              <i class="bi bi-check-circle-fill"></i>
              <%= notice %>
            </div>
          <% end %>
          <% if alert %>
            <div class="inst-alert inst-alert--danger">
              <i class="bi bi-exclamation-triangle-fill"></i>
              <%= alert %>
            </div>
          <% end %>

          <%= yield %>
        </div>

        <footer class="layout-instructor__footer">
          <span>&copy; <%= Time.current.year %> E-Learning Platform</span>
        </footer>
      </div>
    </div>
  </body>
</html>
