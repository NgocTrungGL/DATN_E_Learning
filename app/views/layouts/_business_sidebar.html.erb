<aside class="biz-sidebar">
  <div class="biz-sidebar__header">
    <div class="biz-sidebar__brand">
      <i class="bi bi-briefcase-fill"></i>
      <span class="biz-sidebar__brand-text">Business Portal</span>
    </div>
  </div>

  <nav class="biz-sidebar__nav">
    <a href="<%= business_root_path %>"
       class="biz-sidebar__link <%= 'biz-sidebar__link--active' if controller_name == 'dashboard' %>">
      <i class="bi bi-speedometer2"></i>
      <span>Overview</span>
    </a>

    <div class="biz-sidebar__section-label">EMPLOYEE MANAGEMENT</div>

    <a href="<%= business_employees_path %>"
       class="biz-sidebar__link <%= 'biz-sidebar__link--active' if controller_name == 'employees' %>">
      <i class="bi bi-people-fill"></i>
      <span>Employee List</span>
    </a>

    <div class="biz-sidebar__section-label">TRAINING</div>

    <a href="<%= business_licenses_path %>"
       class="biz-sidebar__link <%= 'biz-sidebar__link--active' if controller_name == 'licenses' %>">
      <i class="bi bi-ticket-perforated"></i>
      <span>Course License Inventory</span>
    </a>
    <a href="<%= business_course_market_index_path %>"
       class="biz-sidebar__link">
      <i class="bi bi-cart-plus"></i>
      <span>Buy More Licenses</span>
    </a>
  </nav>
</aside>
