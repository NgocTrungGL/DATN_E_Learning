<%# ============================================================ %>
<%# REDESIGNED NAVBAR                                            %>
<%# ============================================================ %>

<nav class="navbar navbar-expand-lg lp-navbar sticky-top">
  <div class="container">
    <%# --- LOGO --- %>
    <%= link_to root_path, class: "navbar-brand" do %>
      <i class="bi bi-mortarboard-fill"></i>
      <span>E-Learning</span>
    <% end %>

    <%# --- MOBILE TOGGLER --- %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

      <%# --- NAV LINKS --- %>
      <div class="collapse navbar-collapse" id="navbarMain">
        <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
          
          <%# --- COURSES LINK --- %>
          <li class="nav-item">
            <%= link_to "Courses", courses_path, class: "nav-link" %>
          </li>

          <% if request.path.start_with?('/courses') %>
            <%# --- COURSE PAGE SPECIFIC LINKS --- %>
            <li class="nav-item">
              <%= link_to "E-learning business", (current_user&.company_admin? ? business_root_path : b2b_register_path), class: "nav-link" %>
            </li>
            <li class="nav-item">
              <% if current_user&.instructor? %>
                <%= link_to "For Instructors", instructor_root_path, class: "nav-link" %>
              <% else %>
                <%= link_to "Start Teaching", new_instructor_registration_path, class: "nav-link" %>
              <% end %>
            </li>
          <% else %>
            <%# --- DEFAULT LINKS (ROOT PAGE) --- %>
            <li class="nav-item">
              <%= link_to "Learning Paths", root_path(anchor: "learning-paths"), class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Pricing", root_path(anchor: "pricing"), class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "About", root_path(anchor: "instructors"), class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Contact", root_path(anchor: "cta"), class: "nav-link" %>
            </li>
          <% end %>
          <%# Removed duplicate Pricing link %>
        </ul>

      <%# --- AUTH BUTTONS / USER SECTION --- %>
      <div class="d-flex align-items-center gap-3 btn-group-mobile">
        <% if current_user %>
          <%# --- Logged In State --- %>
          <%# --- CART ICON --- %>
          <div id="navbar-cart-icon">
            <%= render "layouts/navbar_cart_icon" %>
          </div>

          <%# --- NOTIFICATION ICON --- %>
          <%= render "notifications/dropdown" %>

          <div class="nav-item dropdown">
            <a class="nav-link p-0 d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <% if current_user.avatar_url.present? %>
                <img src="<%= current_user.avatar_url %>" class="rounded-circle border" width="38" height="38" style="object-fit: cover;">
              <% else %>
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                  <%= current_user.name.to_s[0].upcase %>
                </div>
              <% end %>
              <span class="d-lg-none fw-bold text-dark"><%= current_user.name %></span>
            </a>

            <ul class="dropdown-menu dropdown-menu-end shadow border-0 pt-0" style="min-width: 260px;">
              <li class="p-4 border-bottom bg-light rounded-top-4">
                <div class="fw-bold text-dark text-truncate"><%= current_user.name %></div>
                <div class="small text-muted text-truncate"><%= current_user.email %></div>
              </li>

              <li>
                <%= link_to student_dashboard_path, class: "dropdown-item d-flex align-items-center gap-2" do %>
                  <i class="bi bi-bar-chart-line"></i>
                  Learning Dashboard
                <% end %>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= link_to my_courses_path, class: "dropdown-item d-flex align-items-center gap-2 mt-2" do %>
                  <i class="bi bi-collection-play"></i>
                  My Courses
                <% end %>
              </li>
              <li>
                <%= link_to wishlists_path, class: "dropdown-item d-flex align-items-center gap-2" do %>
                  <i class="bi bi-heart"></i>
                  My Wishlist
                <% end %>
              </li>
              <li>
                <%= link_to certificates_path, class: "dropdown-item d-flex align-items-center gap-2" do %>
                  <i class="bi bi-award"></i>
                  My Certificates
                <% end %>
              </li>
              <li>
                <%= link_to my_notes_path, class: "dropdown-item d-flex align-items-center gap-2" do %>
                  <i class="bi bi-journal-text"></i>
                  My Notes
                <% end %>
              </li>
              <li>
                <%= link_to subscriptions_path, class: "dropdown-item d-flex align-items-center gap-2" do %>
                  <i class="bi bi-credit-card"></i>
                  Subscription
                  <% if current_user.current_plan != "free" %>
                    <span class="badge rounded-pill ms-auto" style="background:#2563eb; font-size:0.65rem;">
                      <%= current_user.current_plan.upcase %>
                    </span>
                  <% end %>
                <% end %>
              </li>
              <li>
                <%= link_to edit_user_registration_path, class: "dropdown-item d-flex align-items-center gap-2" do %>
                  <i class="bi bi-person-gear"></i>
                  Edit Profile
                <% end %>
              </li>

              <% if current_user.admin? %>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <%= link_to admin_dashboard_path, class: "dropdown-item d-flex align-items-center gap-2 text-danger fw-bold" do %>
                    <i class="bi bi-shield-lock"></i>
                    Admin Dashboard
                  <% end %>
                </li>
              <% end %>

              <li><hr class="dropdown-divider"></li>
              <li>
                <%= button_to destroy_user_session_path, method: :delete, class: "dropdown-item text-start w-100 d-flex align-items-center gap-2" do %>
                  <i class="bi bi-box-arrow-right"></i>
                  Sign Out
                <% end %>
              </li>
            </ul>
          </div>
        <% else %>
          <%# --- Logged Out State --- %>
          <%= link_to "Login", new_user_session_path, class: "btn-login" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "btn-signup" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>

<div class="navbar-backdrop"></div>

<%# Mobile Menu Enhancement Script %>
<script>
  document.addEventListener('turbo:load', function() {
    const toggler = document.querySelector('.navbar-toggler');
    const collapse = document.querySelector('.navbar-collapse');
    const backdrop = document.querySelector('.navbar-backdrop');
    const navbar = document.querySelector('.lp-navbar');

    if (toggler) {
      toggler.addEventListener('click', function() {
        backdrop.classList.toggle('show');
      });
    }

    if (backdrop) {
      backdrop.addEventListener('click', function() {
        collapse.classList.remove('show');
        backdrop.classList.remove('show');
      });
    }

    // Scroll effect
    window.addEventListener('scroll', function() {
      if (window.scrollY > 50) {
        navbar.classList.add('navbar-scrolled');
      } else {
        navbar.classList.remove('navbar-scrolled');
      }
    });

    const scrollToTarget = function(targetId) {
      const target = document.getElementById(targetId);
      if (!target) return;

      const navbarHeight = navbar ? navbar.offsetHeight : 0;
      const targetTop = target.getBoundingClientRect().top + window.scrollY - navbarHeight - 12;
      window.scrollTo({ top: Math.max(targetTop, 0), behavior: 'smooth' });
    };

    const scrollToHashTarget = function() {
      if (!window.location.hash) return;

      scrollToTarget(window.location.hash.slice(1));
    };

    document.querySelectorAll('.lp-navbar .nav-link[href*="#"]').forEach(function(link) {
      link.addEventListener('click', function(event) {
        const url = new URL(link.href, window.location.origin);
        const isSamePage = url.origin === window.location.origin &&
          url.pathname === window.location.pathname &&
          url.hash;

        if (!isSamePage) return;

        event.preventDefault();
        history.pushState(null, '', url.hash);
        scrollToTarget(url.hash.slice(1));
        collapse.classList.remove('show');
        backdrop.classList.remove('show');
      });
    });

    window.setTimeout(scrollToHashTarget, 80);
  });
</script>
