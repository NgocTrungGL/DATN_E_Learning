<% if @quiz_is_finished %>
  <% content_for :quiz_result, true %>
  <%= render 'results', quiz_attempt: @quiz_attempt %>
<% else %>
  <div class="qa-env--modern">
    <header class="qa-topbar">
      <div class="qa-topbar__left">
        <h1 class="qa-topbar__title"><%= @quiz.title %></h1>
        <span class="qa-topbar__course"><%= @quiz.course.title %></span>
      </div>

      <div class="qa-topbar__right">
        <div class="qa-topbar__timer" id="qa-timer-widget">
          <i class="bi bi-clock"></i>
          <span id="quiz-timer">--:--</span>
        </div>
        <div id="timer-data" 
             data-end-time="<%= (@quiz_attempt.started_at + (@quiz.time_limit || 60).minutes).iso8601 %>" 
             hidden></div>

        <button class="qa-topbar__btn-success qa-topbar__submit" onclick="document.getElementById('submitModal').classList.add('is-active')">
          Submit Exam
        </button>
      </div>
    </header>

    <div class="qa-body">
      <main class="qa-main">
        <% if @current_question %>
          <%= render 'question_form',
                quiz_attempt: @quiz_attempt,
                question: @current_question,
                quiz_answer: @quiz_answer %>
        <% else %>
          <div class="u-text-center u-p-5 qa-panel">
            <i class="bi bi-exclamation-triangle u-display-1 u-text-muted"></i>
            <h3 class="u-mt-3">Question not found</h3>
          </div>
        <% end %>
      </main>

      <aside class="qa-sidebar">
        <h3 class="qa-sidebar__title">Question Navigator</h3>
        
        <div class="qa-sidebar__grid">
          <% @all_questions.each_with_index do |q, index| %>
            <% 
              is_answered = @answered_ids.key?(q.id)
              is_current  = (q.id == @current_question&.id)
              
              status_class = if is_current
                               'node--current'
                             elsif is_answered
                               'node--answered'
                             else
                               'node--unanswered'
                             end
            %>
            <%= link_to quiz_attempt_path(@quiz_attempt, question_id: q.id), 
                  class: "qa-sidebar__node #{status_class}" do %>
              <%= index + 1 %>
            <% end %>
          <% end %>
        </div>

        <div class="qa-sidebar__legend">
          <div class="legend-item">
            <div class="legend-box box-answered"></div>
            <span>Answered</span>
          </div>
          <div class="legend-item">
            <div class="legend-box box-unanswered"></div>
            <span>Not Answered</span>
          </div>
          <div class="legend-item">
            <div class="legend-box box-current"></div>
            <span>Current</span>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <%# Custom Modal (No Bootstrap) %>
  <div class="qa-modal" id="submitModal">
    <div class="qa-modal__content">
      <div class="qa-modal__header">
        <h5 class="qa-modal__title">Confirm Submission</h5>
        <button type="button" class="qa-modal__close" onclick="document.getElementById('submitModal').classList.remove('is-active')">&times;</button>
      </div>
      <div class="qa-modal__body u-p-4 u-text-center">
        <% if @unanswered_count.to_i > 0 %>
          <div class="u-mb-3"><i class="bi bi-exclamation-circle u-text-warning u-display-4"></i></div>
          <h4>You have <%= @unanswered_count %> unanswered questions!</h4>
          <p class="u-text-muted">Are you sure you want to submit?</p>
        <% else %>
          <div class="u-mb-3"><i class="bi bi-check-circle u-text-success u-display-4"></i></div>
          <h4>All questions answered!</h4>
          <p class="u-text-muted">Ready to see your results?</p>
        <% end %>
      </div>
      <div class="qa-modal__footer">
        <button type="button" class="qr-btn qr-btn-secondary" onclick="document.getElementById('submitModal').classList.remove('is-active')">Cancel</button>
        <%= button_to "Confirm Submit", finish_quiz_attempt_path(@quiz_attempt), method: :patch, class: "qa-topbar__btn-success" %>
      </div>
    </div>
  </div>

  <%= form_with url: finish_quiz_attempt_path(@quiz_attempt), method: :patch, id: "auto-submit-form", class: "u-d-none" do %><% end %>

  <script>
    document.addEventListener("turbo:load", function() {
      const timerData = document.getElementById("timer-data");
      const timerDisplay = document.getElementById("quiz-timer");
      const timerWidget = document.getElementById("qa-timer-widget");

      if (timerData && timerDisplay) {
        const endTime = new Date(timerData.dataset.endTime).getTime();
        const interval = setInterval(function() {
          const now = new Date().getTime();
          const distance = endTime - now;

          if (distance < 0) {
            clearInterval(interval);
            timerDisplay.innerHTML = "00:00";
            timerWidget.classList.add("danger");
            const autoForm = document.getElementById("auto-submit-form");
            if (autoForm) autoForm.requestSubmit();
            return;
          }

          const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((distance % (1000 * 60)) / 1000);
          timerDisplay.innerHTML = (minutes < 10 ? "0" + minutes : minutes) + ":" + (seconds < 10 ? "0" + seconds : seconds);

          if (distance < 120000) {
            timerWidget.classList.add("danger");
          }
        }, 1000);
        document.addEventListener("turbo:before-cache", () => clearInterval(interval), { once: true });
      }
    });
  </script>
<% end %>
