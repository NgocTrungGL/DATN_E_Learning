<%# Grouping logic %>
<% is_grouped = message.same_group_as?(previous_message) %>

<article class="lumina__msg <%= 'lumina__msg--grouped' if is_grouped %>" id="<%= dom_id(message) %>">
  <% unless is_grouped %>
    <div class="lumina__msg-avatar" style="background: <%= '#' + Digest::MD5.hexdigest(message.author_name)[0..5] %>; color: white;">
      <%= message.author_initial %>
    </div>
  <% else %>
    <div class="lumina__msg-gutter-time">
      <%= message.created_at.strftime("%H:%M") %>
    </div>
  <% end %>

  <div class="lumina__msg-body">
    <% unless is_grouped %>
      <div class="lumina__msg-meta">
        <span class="lumina__msg-author"><%= message.author_name %></span>
        <% if message.instructor_message? %>
          <span class="lumina__msg-badge lumina__msg-badge--instructor">Instructor</span>
        <% end %>
        <span class="lumina__msg-time"><%= message.created_at.strftime("%I:%M %p") %></span>
      </div>
    <% end %>

    <div class="lumina__msg-text">
      <%= render_chat_message(message.content, course) %>
    </div>

    <%# Message reactions list %>
    <%= render "discussion_messages/reactions", message: message, course: course %>

    <%# Replies badge — updated in real-time %>
    <%= render "discussion_messages/replies_badge", message: message, course: course %>
  </div>

  <%# Floating Actions on hover %>
  <div class="lumina__msg-actions">
    <%# Hover reaction picker %>
    <div class="action-btn-dropdown">
      <button class="action-btn" title="Add reaction">
        <i class="bi bi-emoji-smile"></i>
      </button>
      <div class="action-picker-menu">
        <% ["👍", "❤️", "😂", "😮", "😢", "🙏", "🎉", "🚀"].each do |emoji| %>
          <%= button_to toggle_reaction_course_discussion_message_path(course, message),
                        method: :post,
                        params: { emoji: emoji },
                        class: "action-picker-menu__item",
                        form: { class: "action-picker-form", data: { turbo: true } } do %>
            <%= emoji %>
          <% end %>
        <% end %>
      </div>
    </div>

    <button class="action-btn"
            title="Reply in thread"
            data-action="click->lumina-layout#openThread"
            data-thread-url="<%= thread_course_discussion_message_path(course, message) %>">
      <i class="bi bi-chat-left-text"></i>
    </button>
    <% viewer = begin; current_user; rescue; nil; end %>
    <% if viewer && (viewer == message.user || viewer.admin? || course.created_by == viewer.id) %>
      <%= button_to course_discussion_message_path(course, message),
            method: :delete,
            class: "action-btn",
            title: "Delete",
            data: { turbo_confirm: "Delete this message?" } do %>
        <i class="bi bi-trash"></i>
      <% end %>
    <% end %>
  </div>
</article>
