<% content_for :full_width, true %>
<% content_for :body_class, "chat-page-body" %>

<%# Real-time WebSocket subscription %>
<%= turbo_stream_from [@course, :chat] %>

<div class="lumina" data-controller="lumina-layout" data-lumina-layout-target="container">
  
  <%# ── LEFT SIDEBAR ────────────────────────────────────────── %>
  <aside class="lumina__sidebar">
    <div class="lumina__course-info">
      <div class="course-mini">
        <div class="course-mini__icon">
          <i class="bi bi-journal-bookmark-fill"></i>
        </div>
        <div class="course-mini__details">
          <h3 class="course-mini__title"><%= @course.title %></h3>
          <span class="course-mini__tag">Group Discussion</span>
        </div>
      </div>
    </div>

    <div class="lumina__sidebar-stats">
      <div class="lumina__stat">
        <i class="bi bi-people-fill"></i>
        <span><%= @members_count %> members enrolled</span>
      </div>
      <div class="lumina__stat">
        <i class="bi bi-chat-dots"></i>
        <span><%= @course.discussion_messages.count %> messages total</span>
      </div>
    </div>

    <nav class="lumina__nav-section" style="margin-top: 16px;">
      <h4 class="lumina__nav-section-title">Navigation</h4>
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <%= link_to course_path(@course), class: "lumina__nav-link lumina__nav-link--active" do %>
          <i class="bi bi-chat-right-text"></i> Group Chat
        <% end %>
        <%= link_to course_discussion_posts_path(@course), class: "lumina__nav-link" do %>
          <i class="bi bi-layout-text-sidebar-reverse"></i> Forum Threads
        <% end %>
      </div>
    </nav>

    <div class="lumina__sidebar-footer" style="margin-top:auto;">
      <%= link_to course_path(@course), class: "cd-btn cd-btn--outline", style: "width:100%; font-size: 0.8rem; text-align: center;" do %>
        <i class="bi bi-arrow-left"></i> Back to course
      <% end %>
    </div>
  </aside>

  <%# ── MAIN CHAT AREA (CENTER) ───────────────────────────────── %>
  <main class="lumina__main">
    <header class="lumina__header">
      <div class="channel-head">
        <i class="bi bi-chat-right-text"></i>
        <div>
          <h2>General Discussion</h2>
          <span style="font-size: 0.75rem; color: var(--lumina-text-muted); font-weight: 400;">
            Ask questions, share insights, and learn together
          </span>
        </div>
      </div>
      <div class="header-tools">
        <button class="tool-btn" data-action="click->lumina-layout#togglePanel" title="Group info">
          <i class="bi bi-info-circle"></i>
        </button>
      </div>
    </header>

    <div class="lumina__messages" id="chat-scroll-area" data-controller="chat-scroll">
      <% if @messages.empty? %>
        <div class="chatroom__welcome" style="max-width: 500px; margin: 4rem auto; text-align: center;">
          <div class="chatroom__welcome-icon" style="margin: 0 auto 1.5rem;">
            <i class="bi bi-chat-quote" style="font-size: 3rem; color: var(--lumina-primary);"></i>
          </div>
          <h2 class="chatroom__welcome-title" style="font-size: 1.5rem;">Start the conversation!</h2>
          <p class="chatroom__welcome-text" style="color: var(--lumina-text-muted);">
            Ask your instructor a question or share something you learned with your fellow students.
          </p>
        </div>
      <% end %>

      <%# Only DiscussionMessages — clean, unified timeline %>
      <div id="chat-messages">
        <% previous_message = nil %>
        <% last_date = nil %>
        <% @messages.each do |msg| %>
          <% msg_date = msg.created_at.to_date %>
          <% if last_date != msg_date %>
            <%
              day_num = msg.created_at.day
              suffix = case day_num
                       when 1, 21, 31 then "st"
                       when 2, 22 then "nd"
                       when 3, 23 then "rd"
                       else "th"
                       end
              formatted_date = msg.created_at.strftime("%A, %B %-d") + suffix
            %>
            <div class="lumina__date-divider">
              <span><%= formatted_date %></span>
            </div>
            <% last_date = msg_date %>
          <% end %>
          <%= render "discussion_messages/lumina_message",
                message: msg,
                previous_message: previous_message,
                course: @course %>
          <% previous_message = msg %>
        <% end %>
      </div>
    </div>

    <footer class="lumina__footer">
      <%= render "discussion_messages/lumina_form", course: @course, message: @message %>
    </footer>
  </main>

  <%# ── THREAD PANEL (RIGHT) — Loaded via Turbo Frame ──────────── %>
  <aside class="lumina__info-panel" data-lumina-layout-target="infoPanel">
    <div class="lumina__resize-handle" data-action="mousedown->lumina-layout#startResize"></div>
    <header class="lumina__panel-header">
      <h3 data-lumina-layout-target="panelTitle">Thread</h3>
      <button class="tool-btn" data-action="click->lumina-layout#closePanel">
        <i class="bi bi-x-lg"></i>
      </button>
    </header>
    <div class="lumina__panel-body" data-lumina-layout-target="panelContent">
      <%# Content is loaded dynamically via Turbo Frame when clicking Reply %>
      <%= turbo_frame_tag "thread-panel", class: "thread-frame" do %>
        <div class="thread-empty-state">
          <i class="bi bi-chat-right-text"></i>
          <p>Click <strong>Reply</strong> on any message to open a thread discussion here.</p>
        </div>
      <% end %>
    </div>
  </aside>

</div>
