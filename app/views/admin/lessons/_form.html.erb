<% form_scope = @lesson.persisted? ? [:admin, @lesson] : [:admin, @course_module, @lesson] %>
<% submit_text = local_assigns[:submit_text] || (@lesson.persisted? ? 'Update Lesson' : 'Save & Add More') %>

<%= form_with(model: form_scope, class: 'admin-lessons__form', data: { turbo: false }) do |form| %>
  <% if @lesson.errors.any? %>
    <div class="admin-lessons__errors">
      <ul>
        <% @lesson.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="admin-lessons__field">
    <%= form.label :title, 'Lesson Title', class: 'admin-lessons__label' %>
    <%= form.text_field :title,
                        class: 'admin-input admin-lessons__input',
                        placeholder: 'e.g. Introduction to Variables',
                        autofocus: true,
                        required: true %>
  </div>

  <div class="admin-lessons__field">
    <%= form.label :lesson_type, 'Lesson Type', class: 'admin-lessons__label' %>
    <div class="admin-lessons__type-toggle">
      <label class="admin-lessons__type-option <%= 'active' if @lesson.video? || !@lesson.persisted? %>">
        <%= form.radio_button :lesson_type, :video, checked: @lesson.video? || !@lesson.persisted? %>
        <span class="admin-lessons__type-icon"><i class="bi bi-play-circle-fill"></i></span>
        <span class="admin-lessons__type-text">Video</span>
      </label>
      <label class="admin-lessons__type-option <%= 'active' if @lesson.text? %>">
        <%= form.radio_button :lesson_type, :text, checked: @lesson.text? %>
        <span class="admin-lessons__type-icon"><i class="bi bi-file-text-fill"></i></span>
        <span class="admin-lessons__type-text">Text</span>
      </label>
    </div>
  </div>

  <div class="admin-lessons__field">
    <%= form.label :description, 'Description', class: 'admin-lessons__label' %>
    <%= form.text_area :description,
                       rows: 2,
                       class: 'admin-textarea admin-lessons__textarea',
                       placeholder: 'Brief description...' %>
  </div>

  <%# === VIDEO SECTION === %>
  <div id="video-section" class="admin-lessons__field admin-lessons__field--conditional <%= 'hidden' if @lesson.text? %>">

    <%# Upload Type Toggle %>
    <div class="admin-upload-toggle">
      <span class="admin-upload-toggle__label">Video source:</span>
      <div class="admin-upload-toggle__options">
        <label class="admin-upload-toggle__option <%= 'active' if @lesson.link? || !@lesson.persisted? %>" data-upload="link">
          <input type="radio" name="lesson[upload_type]" value="link"
                 <%= 'checked' if @lesson.link? || !@lesson.persisted? %>>
          <i class="bi bi-link-45deg"></i>
          <span>Link only</span>
        </label>
        <label class="admin-upload-toggle__option <%= 'active' if @lesson.cloudinary? %>" data-upload="cloudinary">
          <input type="radio" name="lesson[upload_type]" value="cloudinary"
                 <%= 'checked' if @lesson.cloudinary? %>>
          <i class="bi bi-cloud-arrow-up"></i>
          <span>Upload to storage</span>
        </label>
      </div>
    </div>

    <%# LINK MODE: 2 fields URL, no choose file %>
    <div id="upload-link-section" class="admin-upload-section">
      <div class="admin-upload-section__row">
        <div class="admin-upload-section__field">
          <%= form.label :video_url, 'Video URL', class: 'admin-lessons__label' %>
          <div class="admin-input-group">
            <span class="input-group-text"><i class="bi bi-youtube"></i></span>
            <%= form.text_field :video_url, class: 'admin-input',
                                placeholder: 'https://youtube.com/... or Google Drive link' %>
          </div>
        </div>
        <div class="admin-upload-section__field">
          <%= form.label :document_url, 'Document URL', class: 'admin-lessons__label' %>
          <div class="admin-input-group">
            <span class="input-group-text"><i class="bi bi-file-earmark-text"></i></span>
            <%= form.text_field :document_url, class: 'admin-input',
                                placeholder: 'https://docs.google.com/... or PDF link' %>
          </div>
        </div>
      </div>
    </div>

    <%# UPLOAD MODE: 2 fields upload, with choose file %>
    <div id="upload-cloudinary-section" class="admin-upload-section hidden">
      <div class="admin-upload-section__row">
        <%# Upload Video %>
        <div class="admin-upload-section__field">
          <%= form.label :video_file, 'Upload Video', class: 'admin-lessons__label' %>

          <% if @lesson.video_file.attached? %>
            <div class="admin-upload-preview admin-upload-preview--visible" id="video-preview">
              <div class="admin-upload-preview__icon">
                <i class="bi bi-film"></i>
              </div>
              <div class="admin-upload-preview__info">
                <p class="admin-upload-preview__name"><%= @lesson.video_file.filename %></p>
                <p class="admin-upload-preview__size"><%= number_to_human_size(@lesson.video_file.byte_size) %></p>
              </div>
              <button type="button" class="admin-upload-preview__remove" data-action="remove-video">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>
            <div class="admin-file-dropzone hidden" id="video-upload-area">
              <i class="bi bi-cloud-arrow-up admin-file-dropzone__icon"></i>
              <p class="admin-file-dropzone__text">Drag & drop or <label for="lesson_video_file" class="admin-file-dropzone__browse">choose file</label></p>
              <p class="admin-file-dropzone__hint">MP4, MOV, AVI, WebM</p>
              <%= form.file_field :video_file, id: 'lesson_video_file', class: 'hidden', accept: 'video/*' %>
            </div>
          <% else %>
            <div class="admin-upload-preview hidden" id="video-preview">
              <div class="admin-upload-preview__icon">
                <i class="bi bi-film"></i>
              </div>
              <div class="admin-upload-preview__info">
                <p class="admin-upload-preview__name"></p>
                <p class="admin-upload-preview__size"></p>
              </div>
              <button type="button" class="admin-upload-preview__remove" data-action="remove-video">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>
            <div class="admin-file-dropzone" id="video-upload-area">
              <i class="bi bi-cloud-arrow-up admin-file-dropzone__icon"></i>
              <p class="admin-file-dropzone__text">Drag & drop or <label for="lesson_video_file" class="admin-file-dropzone__browse">choose file</label></p>
              <p class="admin-file-dropzone__hint">MP4, MOV, AVI, WebM</p>
              <%= form.file_field :video_file, id: 'lesson_video_file', class: 'hidden', accept: 'video/*' %>
            </div>
          <% end %>
        </div>

        <%# Upload Document %>
        <div class="admin-upload-section__field">
          <%= form.label :document_file, 'Upload Document', class: 'admin-lessons__label' %>

          <% if @lesson.document_file.attached? %>
            <div class="admin-upload-preview admin-upload-preview--visible" id="doc-preview">
              <div class="admin-upload-preview__icon">
                <i class="bi bi-file-earmark"></i>
              </div>
              <div class="admin-upload-preview__info">
                <p class="admin-upload-preview__name"><%= @lesson.document_file.filename %></p>
                <p class="admin-upload-preview__size"><%= number_to_human_size(@lesson.document_file.byte_size) %></p>
              </div>
              <button type="button" class="admin-upload-preview__remove" data-action="remove-doc">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>
            <div class="admin-file-dropzone hidden" id="doc-upload-area">
              <i class="bi bi-cloud-arrow-up admin-file-dropzone__icon"></i>
              <p class="admin-file-dropzone__text">Drag & drop or <label for="lesson_document_file" class="admin-file-dropzone__browse">choose file</label></p>
              <p class="admin-file-dropzone__hint">PDF, DOCX, ZIP, PNG, JPG</p>
              <%= form.file_field :document_file, id: 'lesson_document_file', class: 'hidden', accept: '.pdf,.doc,.docx,.zip,.png,.jpg,.jpeg' %>
            </div>
          <% else %>
            <div class="admin-upload-preview hidden" id="doc-preview">
              <div class="admin-upload-preview__icon">
                <i class="bi bi-file-earmark"></i>
              </div>
              <div class="admin-upload-preview__info">
                <p class="admin-upload-preview__name"></p>
                <p class="admin-upload-preview__size"></p>
              </div>
              <button type="button" class="admin-upload-preview__remove" data-action="remove-doc">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>
            <div class="admin-file-dropzone" id="doc-upload-area">
              <i class="bi bi-cloud-arrow-up admin-file-dropzone__icon"></i>
              <p class="admin-file-dropzone__text">Drag & drop or <label for="lesson_document_file" class="admin-file-dropzone__browse">choose file</label></p>
              <p class="admin-file-dropzone__hint">PDF, DOCX, ZIP, PNG, JPG</p>
              <%= form.file_field :document_file, id: 'lesson_document_file', class: 'hidden', accept: '.pdf,.doc,.docx,.zip,.png,.jpg,.jpeg' %>
            </div>
          <% end %>
        </div>
      </div>

      <div id="upload-progress" class="admin-upload-progress hidden">
        <div class="admin-upload-progress__bar"><div id="upload-progress-fill"></div></div>
        <span id="upload-progress-text">0%</span>
      </div>
    </div>
  </div>

  <%# === TEXT SECTION === %>
  <div id="text-section" class="admin-lessons__field admin-lessons__field--conditional <%= 'hidden' if @lesson.video? %>">
    <%= form.label :content, 'Lesson Content', class: 'admin-lessons__label' %>
    <div class="trix-editor-wrapper admin-lessons__rich-editor">
      <%= form.rich_text_area :content, placeholder: 'Lesson content...', rows: 10, data: { trix_autofocus: false } %>
    </div>
  </div>

  <%= form.hidden_field :order_index %>

  <div class="admin-lessons__actions">
    <%= link_to 'Back', admin_course_path(@course_module.course), class: 'btn-cancel admin-lessons__action-btn' %>
    <%= form.submit submit_text, class: 'btn-save admin-lessons__action-btn' %>
  </div>
<% end %>

<script>
document.addEventListener('DOMContentLoaded', function() {

  // ========== TOGGLE LESSON TYPE ==========
  document.querySelectorAll('input[name="lesson[lesson_type]"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      var videoSection = document.getElementById('video-section');
      var textSection = document.getElementById('text-section');

      document.querySelectorAll('.admin-lessons__type-option').forEach(function(el) { el.classList.remove('active'); });
      var wrapper = this.closest('.admin-lessons__type-option');
      if (wrapper) wrapper.classList.add('active');

      if (this.value === 'video') {
        videoSection.classList.remove('hidden');
        textSection.classList.add('hidden');
      } else {
        videoSection.classList.add('hidden');
        textSection.classList.remove('hidden');
      }
    });
  });

  // ========== TOGGLE UPLOAD TYPE ==========
  function switchUploadMode(mode) {
    var linkSection = document.getElementById('upload-link-section');
    var cloudSection = document.getElementById('upload-cloudinary-section');

    document.querySelectorAll('.admin-upload-toggle__option').forEach(function(el) { el.classList.remove('active'); });
    var activeLabel = document.querySelector('input[name="lesson[upload_type]"][value="' + mode + '"]');
    if (activeLabel) {
      var wrapper = activeLabel.closest('.admin-upload-toggle__option');
      if (wrapper) wrapper.classList.add('active');
    }

    if (mode === 'link') {
      cloudSection.classList.add('hidden');
      linkSection.classList.remove('hidden');
    } else {
      linkSection.classList.add('hidden');
      cloudSection.classList.remove('hidden');
    }
  }

  document.querySelectorAll('input[name="lesson[upload_type]"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      switchUploadMode(this.value);
    });

    if (radio.checked) {
      radio.dispatchEvent(new Event('change'));
    }
  });

  // ========== DROPZONE DRAG & DROP ==========
  function bindDropzone(dz) {
    if (!dz) return;
    dz.addEventListener('dragover', function(e) { e.preventDefault(); dz.classList.add('drag-over'); });
    dz.addEventListener('dragleave', function() { dz.classList.remove('drag-over'); });
    dz.addEventListener('drop', function(e) {
      e.preventDefault();
      dz.classList.remove('drag-over');
      var files = e.dataTransfer.files;
      var input = dz.querySelector('input[type="file"]');
      if (input && files.length) {
        var dt = new DataTransfer();
        Array.from(files).forEach(function(f) { dt.items.add(f); });
        input.files = dt.files;
        input.dispatchEvent(new Event('change'));
      }
    });
  }
  document.querySelectorAll('.admin-file-dropzone').forEach(bindDropzone);

  // ========== VIDEO FILE: hide dropzone, show preview ==========
  var videoInput = document.getElementById('lesson_video_file');
  if (videoInput) {
    videoInput.addEventListener('change', function() {
      if (this.files.length) {
        var dropzone = document.getElementById('video-upload-area');
        var previewArea = document.getElementById('video-preview');
        if (dropzone && previewArea) {
          dropzone.classList.add('hidden');
          previewArea.classList.remove('hidden');
          previewArea.classList.add('admin-upload-preview--visible');
          var nameEl = previewArea.querySelector('.admin-upload-preview__name');
          var sizeEl = previewArea.querySelector('.admin-upload-preview__size');
          if (nameEl) nameEl.textContent = this.files[0].name;
          if (sizeEl) sizeEl.textContent = formatSize(this.files[0].size);
        }
      }
    });
  }

  // ========== DOCUMENT FILE: hide dropzone, show preview ==========
  var docInput = document.getElementById('lesson_document_file');
  if (docInput) {
    docInput.addEventListener('change', function() {
      if (this.files.length) {
        var dropzone = document.getElementById('doc-upload-area');
        var previewArea = document.getElementById('doc-preview');
        if (dropzone && previewArea) {
          dropzone.classList.add('hidden');
          previewArea.classList.remove('hidden');
          previewArea.classList.add('admin-upload-preview--visible');
          var nameEl = previewArea.querySelector('.admin-upload-preview__name');
          var sizeEl = previewArea.querySelector('.admin-upload-preview__size');
          if (nameEl) nameEl.textContent = this.files[0].name;
          if (sizeEl) sizeEl.textContent = formatSize(this.files[0].size);
        }
      }
    });
  }

  // ========== REMOVE VIDEO / DOCUMENT ==========
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-action="remove-video"]');
    if (btn) {
      e.preventDefault();
      var dropzone = document.getElementById('video-upload-area');
      var previewArea = document.getElementById('video-preview');
      var input = document.getElementById('lesson_video_file');
      if (dropzone && previewArea && input) {
        var nameEl = previewArea.querySelector('.admin-upload-preview__name');
        var sizeEl = previewArea.querySelector('.admin-upload-preview__size');
        if (nameEl) nameEl.textContent = '';
        if (sizeEl) sizeEl.textContent = '';
        previewArea.classList.add('hidden');
        previewArea.classList.remove('admin-upload-preview--visible');
        dropzone.classList.remove('hidden');
        input.value = '';
      }
    }

    var docBtn = e.target.closest('[data-action="remove-doc"]');
    if (docBtn) {
      e.preventDefault();
      var dropzone = document.getElementById('doc-upload-area');
      var previewArea = document.getElementById('doc-preview');
      var input = document.getElementById('lesson_document_file');
      if (dropzone && previewArea && input) {
        var nameEl = previewArea.querySelector('.admin-upload-preview__name');
        var sizeEl = previewArea.querySelector('.admin-upload-preview__size');
        if (nameEl) nameEl.textContent = '';
        if (sizeEl) sizeEl.textContent = '';
        previewArea.classList.add('hidden');
        previewArea.classList.remove('admin-upload-preview--visible');
        dropzone.classList.remove('hidden');
        input.value = '';
      }
    }
  });

  // Helper format size
  function formatSize(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }
});
</script>
