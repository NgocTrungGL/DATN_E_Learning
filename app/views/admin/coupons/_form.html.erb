<div class="admin-page-header admin-coupons-hero">
  <div class="admin-page-header__inner">
    <div>
      <div class="admin-page-header__badge">
        <i class="bi bi-ticket-perforated-fill"></i>
        Promotions
      </div>
      <h1 class="admin-page-header__title">
        <%= @coupon.new_record? ? "Create Coupon" : "Edit Coupon" %>
      </h1>
      <p class="admin-coupons-hero__subtitle">
        Configure discount rules, availability windows, and promotion scope.
      </p>
    </div>

    <%= link_to admin_coupons_path, class: "admin-coupons-action admin-coupons-action--secondary" do %>
      <i class="bi bi-arrow-left"></i>
      Back to Coupons
    <% end %>
  </div>
</div>

<div class="admin-page-body admin-coupons">
  <%= form_with(model: [:admin, @coupon],
        html: {
          class: "admin-coupon-form",
          data: { controller: "coupon-form" }
        }) do |f| %>
    <% if @coupon.errors.any? %>
      <div class="admin-alert admin-alert--danger">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>
          <strong><%= pluralize(@coupon.errors.count, "error") %> need fixing:</strong>
          <ul>
            <% @coupon.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <div class="admin-card">
      <div class="admin-card__header admin-coupons-card__header">
        <span class="step-badge">1</span>
        <h5>Coupon details</h5>
      </div>

      <div class="admin-card__body">
        <div class="admin-grid-2">
          <div class="admin-field">
            <%= f.label :code, "Coupon code", class: "admin-field__label admin-field__label--required" %>
            <%= f.text_field :code,
                  class: "admin-input admin-coupon-form__code-input",
                  placeholder: "Example: SUMMER2026",
                  required: true %>
            <span class="admin-field__hint">Use a short memorable code for learners.</span>
          </div>

          <div class="admin-field">
            <%= f.label :status, "Status", class: "admin-field__label admin-field__label--required" %>
            <%= f.select :status,
                  Coupon.statuses.keys.map { |key| [key.humanize, key] },
                  {},
                  { class: "admin-select" } %>
          </div>
        </div>

        <div class="admin-grid-2">
          <div class="admin-field">
            <%= f.label :discount_type, "Discount type", class: "admin-field__label admin-field__label--required" %>
            <%= f.select :discount_type,
                  Coupon.discount_types.keys.map { |key| [key.humanize, key] },
                  {},
                  { class: "admin-select" } %>
          </div>

          <div class="admin-field">
            <%= f.label :discount_value, "Discount value", class: "admin-field__label admin-field__label--required" %>
            <div class="admin-coupon-form__value-field">
              <%= f.number_field :discount_value,
                    class: "admin-input",
                    step: :any,
                    required: true %>
              <span>% / VND</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-card__header admin-coupons-card__header">
        <span class="step-badge">2</span>
        <h5>Availability and scope</h5>
      </div>

      <div class="admin-card__body">
        <div class="admin-grid-2">
          <div class="admin-field">
            <%= f.label :start_at, "Start time", class: "admin-field__label admin-field__label--required" %>
            <%= f.datetime_local_field :start_at, class: "admin-input", required: true %>
          </div>

          <div class="admin-field">
            <%= f.label :end_at, "End time", class: "admin-field__label admin-field__label--required" %>
            <%= f.datetime_local_field :end_at, class: "admin-input", required: true %>
          </div>
        </div>

        <div class="admin-grid-2">
          <div class="admin-field">
            <%= f.label :target_type, "Scope", class: "admin-field__label admin-field__label--required" %>
            <%= f.select :target_type,
                  Coupon.target_types.keys.map { |key| [key.humanize, key] },
                  {},
                  {
                    class: "admin-select",
                    data: {
                      coupon_form_target: "targetType",
                      action: "change->coupon-form#toggleCourseField"
                    }
                  } %>
            <span class="admin-field__hint">Choose whether this coupon applies everywhere or to one course.</span>
          </div>

          <div class="admin-field">
            <%= f.label :usage_limit, "Usage limit", class: "admin-field__label" %>
            <%= f.number_field :usage_limit,
                  class: "admin-input",
                  min: 0,
                  placeholder: "0 means unlimited" %>
            <span class="admin-field__hint">Use 0 for unlimited redemptions.</span>
          </div>
        </div>

        <div class="admin-coupon-form__course-field <%= 'is-hidden' unless @coupon.specific_course? %>"
             data-coupon-form-target="courseField">
          <div class="admin-field">
            <%= f.label :course_id, "Course", class: "admin-field__label" %>
            <%= f.collection_select :course_id,
                  @courses,
                  :id,
                  :title,
                  { include_blank: "--- Select a course ---" },
                  { class: "admin-select" } %>
            <span class="admin-field__hint">Required when the coupon is course-specific.</span>
          </div>
        </div>
      </div>
    </div>

    <div class="admin-form-actions">
      <%= link_to admin_coupons_path, class: "btn-cancel" do %>
        Cancel
      <% end %>
      <%= f.submit @coupon.new_record? ? "Create Coupon" : "Update Coupon", class: "btn-save" %>
    </div>
  <% end %>
</div>
