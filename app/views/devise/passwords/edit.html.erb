<div class="auth-wrapper">
  <div class="auth-split-layout">
    <div class="auth-image-panel">
      <div class="image-overlay">
        <h2>Secure Your Account</h2>
        <p>Choose a strong password to protect your learning progress.</p>
      </div>
    </div>
    
    <div class="auth-form-panel">
      <div class="auth-form-inner">
        <h1 class="auth-title" style="margin-bottom: 8px;">Set New Password</h1>
        <p class="auth-subtitle text-center" style="margin-bottom: 32px;">Please enter your new password below.</p>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>
          <%= f.hidden_field :reset_password_token %>

          <div class="field-group">
            <%= f.label :password, "New password", class: "field-label" %>
            <div class="input-wrap">
              <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: (@minimum_password_length ? "At least #{@minimum_password_length} characters" : "New password") %>
            </div>
          </div>

          <div class="field-group mt-3">
            <%= f.label :password_confirmation, "Confirm new password", class: "field-label" %>
            <div class="input-wrap">
              <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm new password" %>
            </div>
          </div>

          <div class="field-group" style="margin-top: 24px;">
            <%= f.submit "Change my password", class: "btn-login" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
