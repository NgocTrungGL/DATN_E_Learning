<div class="auth-wrapper">
  <div class="auth-split-layout">
    <div class="auth-image-panel">
      <div class="image-overlay">
        <h2>Password Recovery</h2>
        <p>Securely regain access to your learning journey.</p>
      </div>
    </div>
    
    <div class="auth-form-panel">
      <div class="auth-form-inner">
        <h1 class="auth-title" style="margin-bottom: 8px;">Forgot your password?</h1>
        <p class="auth-subtitle text-center" style="margin-bottom: 32px;">Enter your email and we will send reset instructions.</p>

        <%# IMPORTANT: Keep url as user_password_path %>
        <%= form_for(resource, as: resource_name, url: user_password_path, html: { method: :post }) do |f| %>
          
          <%# Show errors for invalid email %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="field-group">
            <%= f.label :email, "Email address", class: "field-label" %>
            <div class="input-wrap">
              <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Enter your email" %>
            </div>
          </div>

          <div class="field-group" style="margin-top: 24px;">
            <%= f.submit "Send instructions", class: "btn-login" %>
          </div>

          <div class="field-group text-center" style="margin-top: 24px;">
            <%= link_to "Back to Login", new_user_session_path, class: "forgot-link" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
