<article class="lesson-tabs__overview">
  <header class="lesson-tabs__hero">
    <div class="lesson-tabs__hero-content">
      <p class="lesson-tabs__eyebrow">Learning Experience</p>
      <h2 class="lesson-tabs__heading">
        <%= @lesson.description.present? ? @lesson.description : @lesson.title %>
      </h2>
      <% if @lesson.description.present? %>
        <p class="lesson-tabs__description">
          <%= simple_format(@lesson.description) %>
        </p>
      <% end %>

      <%# Tai lieu - thang hang voi title %>
      <% doc_url = @lesson.document_url.presence || (@lesson.cloudinary? && @lesson.document_file.attached? ? rails_blob_path(@lesson.document_file, disposition: "attachment") : nil) %>
      <% if doc_url.present? %>
        <div class="lesson-tabs__inline-download">
          <a href="<%= doc_url %>" target="_blank" class="lesson-tabs__inline-download-link">
            <i class="bi bi-file-earmark-arrow-down"></i>
            <span>Lesson Materials</span>
          </a>
        </div>
      <% end %>
    </div>

    <aside class="lesson-tabs__hero-stats" aria-label="Lesson quick stats">
      <% if @lesson.video? && @lesson.link? && @lesson.formatted_duration.present? %>
        <div class="lesson-tabs__stat-card">
          <span class="lesson-tabs__stat-icon"><i class="bi bi-clock"></i></span>
          <div class="lesson-tabs__stat-body">
            <span class="lesson-tabs__stat-value"><%= @lesson.formatted_duration %></span>
            <span class="lesson-tabs__stat-label">Duration</span>
          </div>
        </div>
      <% end %>
      <% if @lesson.document_url.present? || (@lesson.cloudinary? && @lesson.document_file.attached?) %>
        <div class="lesson-tabs__stat-card">
          <span class="lesson-tabs__stat-icon"><i class="bi bi-file-earmark-text"></i></span>
          <div class="lesson-tabs__stat-body">
            <span class="lesson-tabs__stat-value"><i class="bi bi-check-lg"></i></span>
            <span class="lesson-tabs__stat-label">Has Doc</span>
          </div>
        </div>
      <% end %>
    </aside>
  </header>
</article>
