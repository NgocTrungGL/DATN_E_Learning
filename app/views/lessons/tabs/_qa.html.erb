<article class="lesson-tabs__qa">
  <header class="lesson-tabs__qa-toolbar">
    <label class="lesson-tabs__search-wrap" for="lesson-qa-search">
      <svg class="lesson-tabs__search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M11 19C15.4183 19 19 15.4183 19 11C19 6.58172 15.4183 3 11 3C6.58172 3 3 6.58172 3 11C3 15.4183 6.58172 19 11 19Z" stroke="currentColor" stroke-width="1.8"/>
        <path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
      <input id="lesson-qa-search" class="lesson-tabs__search-input" type="search" placeholder="Search community questions" aria-label="Search questions">
    </label>

    <% if user_signed_in? %>
    <button class="lesson-tabs__ask-btn" type="button"
            onclick="document.getElementById('luminaAskModal').classList.add('is-open'); document.body.style.overflow='hidden'">
      <i class="bi bi-plus-circle"></i> Ask a question
    </button>
    <% end %>
  </header>

  <% if !user_signed_in? %>
    <div class="lesson-tabs__coming">
      <span class="lesson-tabs__coming-icon" aria-hidden="true">
        <i class="bi bi-lock" style="font-size: 1.4rem;"></i>
      </span>
      <div class="lesson-tabs__coming-content">
        <h3 class="lesson-tabs__coming-title">Sign in to ask a question</h3>
        <p class="lesson-tabs__coming-subtitle">
          Join the discussion by signing in to ask questions and help others.
        </p>
      </div>
    </div>

  <% elsif @qa_comments.any? %>
    <div class="lesson-tabs__question-list" id="question-list">
      <% @qa_comments.each do |comment| %>
        <%= render "comments/question_card", lesson: @lesson, comment: comment %>
      <% end %>
    </div>

  <% else %>
    <div class="lesson-tabs__coming">
      <span class="lesson-tabs__coming-icon" aria-hidden="true">
        <i class="bi bi-chat-square-text" style="font-size: 1.4rem;"></i>
      </span>
      <div class="lesson-tabs__coming-content">
        <h3 class="lesson-tabs__coming-title">No questions yet</h3>
        <p class="lesson-tabs__coming-subtitle">
          Be the first to ask a question about this lesson!
        </p>
      </div>
    </div>
  <% end %>
</article>

<% if user_signed_in? %>
<div class="lumina-ask-modal" id="luminaAskModal" aria-labelledby="luminaAskModalLabel" role="dialog" aria-modal="true"
     data-controller="question-modal">
  <div class="lumina-ask-backdrop" data-action="click->question-modal#closeOnBackdrop"></div>
  <div class="lumina-ask-card">
    <div class="lumina-ask-topbar">
      <div class="lumina-ask-topbar-left">
        <span class="lumina-ask-topbar-icon" aria-hidden="true">
          <i class="bi bi-chat-square-text-fill"></i>
        </span>
        <h2 class="lumina-ask-topbar-title" id="luminaAskModalLabel">Ask a discussion question</h2>
      </div>
      <button class="lumina-ask-close" type="button" aria-label="Close" data-action="question-modal#close">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <div class="lumina-ask-content">
      <div class="lumina-ask-user">
        <img
          src="https://ui-avatars.com/api/?name=<%= URI.encode_www_form_component(current_user&.name || "User") %>&background=random&color=fff"
          alt="<%= current_user&.name %>"
          class="lumina-ask-avatar"
        >
        <div class="lumina-ask-user-info">
          <span class="lumina-ask-user-name"><%= current_user&.name %></span>
          <span class="lumina-ask-user-sub">Asking about: <strong><%= @lesson.title %></strong></span>
        </div>
      </div>

      <%= form_with(model: [@lesson, Comment.new], local: true) do |f| %>
        <div class="lumina-ask-input-card">
          <%= f.label :body, "Question details", class: "lumina-ask-input-label" %>
          <%= f.text_area :body,
              class: "lumina-ask-input-area",
              placeholder: "Describe your question in detail so the instructor and others can help...",
              rows: 5,
              required: true %>
        </div>

        <div class="lumina-ask-notice">
          <span class="lumina-ask-notice-icon" aria-hidden="true">
            <i class="bi bi-info-circle-fill"></i>
          </span>
          <span>Please use polite and respectful language.</span>
        </div>

        <div class="lumina-ask-footer">
          <button type="button" class="lumina-ask-btn lumina-ask-btn--cancel" data-action="question-modal#close">Cancel</button>
          <%= f.submit "Submit question", class: "lumina-ask-btn lumina-ask-btn--submit", data: { disable_with: false } %>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>
