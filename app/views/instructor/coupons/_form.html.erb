<div class="inst-form">
  <%= form_with(model: [:instructor, @coupon]) do |f| %>
    <% if @coupon.errors.any? %>
      <div class="inst-alert inst-alert--danger">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <ul style="margin: 0; padding-left: 1.25rem;">
          <% @coupon.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="inst-form__two-col">
      <div class="inst-form__main">
        <div class="inst-form__section">
          <h3 class="inst-form__section-title">Coupon Details</h3>

          <div class="inst-form__row">
            <div class="inst-form__group">
              <%= f.label :code, "Coupon Code", class: "inst-form__label" %>
              <%= f.text_field :code, class: "inst-form__input", required: true,
                  placeholder: "e.g. SUMMER30", style: "font-family: monospace; letter-spacing: 1px;" %>
            </div>
            <div class="inst-form__group">
              <%= f.label :status, "Status", class: "inst-form__label" %>
              <%= f.select :status, Coupon.statuses.keys.map { |k| [k.humanize.titleize, k] }, {},
                  class: "inst-form__select" %>
            </div>
          </div>

          <div class="inst-form__row">
            <div class="inst-form__group">
              <%= f.label :discount_type, "Discount Type", class: "inst-form__label" %>
              <%= f.select :discount_type, Coupon.discount_types.keys.map { |k| [k.humanize.titleize, k] }, {},
                  class: "inst-form__select" %>
            </div>
            <div class="inst-form__group">
              <%= f.label :discount_value, "Discount Value", class: "inst-form__label" %>
              <div class="inst-form__input-group">
                <%= f.number_field :discount_value, class: "inst-form__input", step: :any, required: true %>
                <span class="inst-form__input-prefix">% / VND</span>
              </div>
            </div>
          </div>

          <div class="inst-form__row">
            <div class="inst-form__group">
              <%= f.label :start_at, "Start Date", class: "inst-form__label" %>
              <%= f.datetime_local_field :start_at, class: "inst-form__input", required: true %>
            </div>
            <div class="inst-form__group">
              <%= f.label :end_at, "End Date", class: "inst-form__label" %>
              <%= f.datetime_local_field :end_at, class: "inst-form__input", required: true %>
            </div>
          </div>

          <div class="inst-form__group">
            <%= f.label :course_id, "Course", class: "inst-form__label" %>
            <%= f.collection_select :course_id, @courses, :id, :title,
                { include_blank: "Select a course" }, class: "inst-form__select" %>
            <span class="inst-form__hint">Instructors can only create coupons for their own courses.</span>
          </div>

          <div class="inst-form__group">
            <%= f.label :usage_limit, "Usage Limit", class: "inst-form__label" %>
            <%= f.number_field :usage_limit, class: "inst-form__input", min: 0, placeholder: "0 = unlimited" %>
            <span class="inst-form__hint">Enter 0 for unlimited usage.</span>
          </div>
        </div>
      </div>

      <div class="inst-form__sidebar">
        <div class="coupon-preview">
          <div class="coupon-preview__label">Preview</div>
          <div class="coupon-preview__card">
            <div class="coupon-preview__discount">
              <i class="bi bi-tag-fill"></i>
            </div>
            <div class="coupon-preview__info">
              <span class="coupon-preview__code"><%= @coupon.code.presence || "SUMMER30" %></span>
              <span class="coupon-preview__value">
                <%= @coupon.discount_value.presence || "20" %>% Off
              </span>
              <span class="coupon-preview__course"><%= @coupon.course&.title || "Selected course" %></span>
            </div>
          </div>
        </div>

        <div class="inst-form__actions">
          <%= f.submit "Save Coupon", class: "btn btn-primary", style: "width: 100%;" %>
          <a href="<%= instructor_coupons_path %>" class="btn btn-outline" style="width: 100%;">
            Cancel
          </a>
        </div>
      </div>
    </div>
  <% end %>
</div>
