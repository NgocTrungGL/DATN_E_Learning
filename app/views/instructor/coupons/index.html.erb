<div class="inst-page">
  <div class="inst-page__header">
    <div>
      <h1 class="inst-page__title">Coupons</h1>
      <p class="inst-page__subtitle">Manage discount codes for your courses</p>
    </div>
    <div class="inst-page__actions">
      <a href="<%= new_instructor_coupon_path %>" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        New Coupon
      </a>
    </div>
  </div>

  <% if @coupons.any? %>
    <%# Stats Cards %>
    <div class="coupon-stats-grid">
      <div class="coupon-stat-card">
        <div class="coupon-stat-card__icon" style="background: rgba(16,185,129,0.1); color: #10b981;">
          <i class="bi bi-check-circle"></i>
        </div>
        <div class="coupon-stat-card__body">
          <span class="coupon-stat-card__value"><%= @coupons.active.count %></span>
          <span class="coupon-stat-card__label">Active Coupons</span>
        </div>
      </div>
      <div class="coupon-stat-card">
        <div class="coupon-stat-card__icon" style="background: rgba(37,99,235,0.1); color: #2563eb;">
          <i class="bi bi-ticket"></i>
        </div>
        <div class="coupon-stat-card__body">
          <span class="coupon-stat-card__value"><%= @coupons.sum(&:usage_count) %></span>
          <span class="coupon-stat-card__label">Total Uses</span>
        </div>
      </div>
      <div class="coupon-stat-card">
        <div class="coupon-stat-card__icon" style="background: rgba(16,185,129,0.1); color: #10b981;">
          <i class="bi bi-cash-coin"></i>
        </div>
        <div class="coupon-stat-card__body">
          <span class="coupon-stat-card__value">
            <%= format_vnd(@coupons.sum(&:revenue_generated)) %>
          </span>
          <span class="coupon-stat-card__label">Revenue Generated</span>
        </div>
      </div>
      <div class="coupon-stat-card">
        <div class="coupon-stat-card__icon" style="background: rgba(245,158,11,0.1); color: #f59e0b;">
          <i class="bi bi-percent"></i>
        </div>
        <div class="coupon-stat-card__body">
          <span class="coupon-stat-card__value">
            <%= format_vnd(@coupons.sum(&:total_discount_given)) %>
          </span>
          <span class="coupon-stat-card__label">Total Discount Given</span>
        </div>
      </div>
    </div>

    <div class="inst-card">
      <div class="data-table__wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Code</th>
              <th>Discount</th>
              <th>Course</th>
              <th style="text-align: center;">Uses</th>
              <th style="text-align: center;">Conversion</th>
              <th style="text-align: center;">Revenue</th>
              <th>Valid Period</th>
              <th>Status</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @coupons.each do |coupon| %>
              <tr>
                <td>
                  <code class="coupon-code"><%= coupon.code %></code>
                </td>
                <td>
                  <span class="coupon-discount">
                    <%= coupon.percentage? ? "#{coupon.discount_value}%" : format_vnd(coupon.discount_value) %>
                  </span>
                </td>
                <td>
                  <span class="coupon-course"><%= coupon.course&.title || "—" %></span>
                </td>
                <td style="text-align: center;">
                  <span style="font-weight: 600;"><%= coupon.usage_count %></span>
                  <% if coupon.usage_limit > 0 %>
                    <span style="font-size: 0.75rem; color: #94a3b8;">/ <%= coupon.usage_limit %></span>
                  <% end %>
                </td>
                <td style="text-align: center;">
                  <div class="conv-cell">
                    <div class="conv-bar">
                      <div class="conv-bar__fill" style="width: <%= coupon.conversion_rate %>%;"></div>
                    </div>
                    <span><%= coupon.conversion_rate %>%</span>
                  </div>
                </td>
                <td style="text-align: center;">
                  <span style="font-weight: 600; color: #10b981;">
                    <%= format_vnd(coupon.revenue_generated) %>
                  </span>
                </td>
                <td>
                  <span class="coupon-date">
                    <i class="bi bi-calendar"></i>
                    <%= coupon.start_at.strftime("%d %b %Y") %>
                    &ndash;
                    <%= coupon.end_at.strftime("%d %b %Y") %>
                  </span>
                </td>
                <td>
                  <% if coupon.active? && coupon.active_and_current? %>
                    <span class="badge badge--success">Active</span>
                  <% elsif coupon.inactive? %>
                    <span class="badge badge--secondary">Inactive</span>
                  <% elsif coupon.expired? %>
                    <span class="badge badge--danger">Expired</span>
                  <% else %>
                    <span class="badge badge--warning">Scheduled</span>
                  <% end %>
                </td>
                <td>
                  <div class="data-table__cell-actions">
                    <a href="<%= edit_instructor_coupon_path(coupon) %>" class="btn-icon btn-icon--sm" title="Edit">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <%= button_to instructor_coupon_path(coupon), method: :delete,
                        class: "btn-icon btn-icon--sm btn-icon--danger",
                        title: "Delete",
                        data: { confirm: "Delete this coupon?" } do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="inst-empty-state">
      <div class="inst-empty-state__icon">
        <i class="bi bi-ticket-perforated"></i>
      </div>
      <h2>No coupons yet</h2>
      <p>Create discount codes to boost your course sales.</p>
      <a href="<%= new_instructor_coupon_path %>" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        Create Your First Coupon
      </a>
    </div>
  <% end %>
</div>
