<div class="inst-form">
  <%= form_with(model: [:instructor, @question]) do |f| %>
    <% if @question.errors.any? %>
      <div class="inst-alert inst-alert--danger">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <ul style="margin: 0; padding-left: 1.25rem;">
          <% @question.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="inst-form__two-col">
      <%# Left Column: Question Details %>
      <div class="inst-form__main">
        <div class="inst-form__section">
          <h3 class="inst-form__section-title">Question Content</h3>

          <div class="inst-form__group">
            <%= f.label :question_text, "Question Text", class: "inst-form__label" %>
            <%= f.text_area :question_text, rows: 3, class: "inst-form__textarea", required: true,
                placeholder: "Enter your question here..." %>
          </div>

          <div class="inst-form__row">
            <div class="inst-form__group">
              <%= f.label :question_type, "Question Type", class: "inst-form__label" %>
              <%= f.select :question_type, Question.question_types.keys, {},
                  class: "inst-form__select" %>
            </div>
            <div class="inst-form__group">
              <%= f.label :difficulty, "Difficulty", class: "inst-form__label" %>
              <%= f.select :difficulty, Question.difficulties.keys, {},
                  class: "inst-form__select" %>
            </div>
          </div>

          <div class="inst-form__row">
            <div class="inst-form__group">
              <%= f.label :course_id, "Course", class: "inst-form__label" %>
              <%= f.collection_select :course_id, @courses, :id, :title,
                  { include_blank: "Select a course" }, class: "inst-form__select" %>
            </div>
            <div class="inst-form__group">
              <%= f.label :lesson_id, "Lesson (optional)", class: "inst-form__label" %>
              <%# Lesson selector would ideally be dynamic based on selected course %>
              <%= f.number_field :lesson_id, class: "inst-form__input",
                  placeholder: "Enter lesson ID" %>
            </div>
          </div>
        </div>
      </div>

      <%# Right Column: Answer Options %>
      <div class="inst-form__sidebar">
        <div class="inst-form__section">
          <h3 class="inst-form__section-title">Answer Options</h3>
          <p class="inst-form__hint" style="margin-bottom: 1rem;">
            Check the box next to the correct answer.
          </p>

          <div class="answer-options">
            <%= f.fields_for :question_options do |o_form| %>
              <div class="answer-option">
                <label class="answer-option__check">
                  <%= o_form.check_box :is_correct, class: "answer-option__checkbox" %>
                  <span class="answer-option__box"></span>
                </label>
                <%= o_form.text_field :option_text, class: "answer-option__input",
                    placeholder: "Enter answer option..." %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="inst-form__actions">
          <%= f.submit "Save Question", class: "btn btn-primary", style: "width: 100%;" %>
          <a href="<%= instructor_questions_path %>" class="btn btn-outline" style="width: 100%;">
            Cancel
          </a>
        </div>
      </div>
    </div>
  <% end %>
</div>
