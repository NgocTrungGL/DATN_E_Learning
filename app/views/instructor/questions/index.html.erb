<div class="inst-page">
  <div class="inst-page__header">
    <div>
      <h1 class="inst-page__title">Question Bank</h1>
      <p class="inst-page__subtitle">Manage your quiz questions</p>
    </div>
    <div class="inst-page__actions">
      <a href="<%= new_instructor_question_path %>" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        New Question
      </a>
    </div>
  </div>

  <% if @questions.any? %>
    <div class="inst-card">
      <div class="data-table__wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 40%;">Question</th>
              <th>Type / Difficulty</th>
              <th>Course / Lesson</th>
              <th style="width: 120px; text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @questions.each do |question| %>
              <tr>
                <td>
                  <div class="question-cell">
                    <span class="question-cell__text"><%= question.question_text %></span>
                    <span class="question-cell__correct">
                      <i class="bi bi-check-circle"></i>
                      <%= question.question_options.find { |o| o.is_correct }&.option_text || "Not set" %>
                    </span>
                  </div>
                </td>
                <td>
                  <span class="badge badge--secondary"><%= question.question_type.titleize %></span>
                  <span class="badge badge--<%= question.difficulty %>"><%= question.difficulty.titleize %></span>
                </td>
                <td>
                  <% if question.course %>
                    <span class="question-cell__course"><%= question.course.title %></span>
                  <% end %>
                  <% if question.lesson %>
                    <span class="question-cell__lesson">
                      <i class="bi bi-play-circle"></i>
                      <%= question.lesson.title %>
                    </span>
                  <% end %>
                  <% unless question.course || question.lesson %>
                    <span style="color: #94a3b8; font-size: 0.82rem;">Unassigned</span>
                  <% end %>
                </td>
                <td>
                  <div class="data-table__cell-actions">
                    <a href="<%= edit_instructor_question_path(question) %>" class="btn-icon btn-icon--sm" title="Edit">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <%= button_to instructor_question_path(question), method: :delete,
                        class: "btn-icon btn-icon--sm btn-icon--danger",
                        title: "Delete",
                        data: { confirm: "Delete this question?" } do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="data-table__footer">
          <span class="data-table__info">Showing <%= @pagy.items %> of <%= @pagy.count %> questions</span>
          <div class="inst-pagination" style="margin: 0;">
            <%== pagy_nav(@pagy) %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="inst-empty-state">
      <div class="inst-empty-state__icon">
        <i class="bi bi-puzzle"></i>
      </div>
      <h2>No questions yet</h2>
      <p>Create questions to build your quiz question bank.</p>
      <a href="<%= new_instructor_question_path %>" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        Create Your First Question
      </a>
    </div>
  <% end %>
</div>
