<div class="inst-page">
  <div class="inst-page__header">
    <div>
      <h1 class="inst-page__title">Revenue</h1>
      <p class="inst-page__subtitle">Track your earnings and payouts</p>
    </div>
  </div>

  <%# KPI Row %>
  <div class="inst-page__kpi-grid" style="grid-template-columns: repeat(2, 1fr); margin-bottom: 2rem;">
    <div class="kpi-card">
      <div class="kpi-card__icon kpi-card__icon--success">
        <i class="bi bi-wallet2"></i>
      </div>
      <div class="kpi-card__body">
        <span class="kpi-card__value">
          <%= format_vnd(@wallet.balance) %>
        </span>
        <span class="kpi-card__label">Available Balance</span>
        <span class="kpi-card__meta">Minimum: 100,000 VND</span>
      </div>
      <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#payoutModal">
        <i class="bi bi-bank"></i>
        Withdraw
      </button>
    </div>

    <div class="kpi-card">
      <div class="kpi-card__icon kpi-card__icon--primary">
        <i class="bi bi-cash-coin"></i>
      </div>
      <div class="kpi-card__body">
        <span class="kpi-card__value">
          <% total_earned = @wallet.wallet_transactions.where(transaction_type: 'sale_commission').sum(:amount) %>
          <%= format_vnd(total_earned) %>
        </span>
        <span class="kpi-card__label">Total Earnings</span>
        <span class="kpi-card__meta">Lifetime commission from sales</span>
      </div>
    </div>
  </div>

  <%# Chart %>
  <div class="inst-card inst-chart-card inst-chart-card--hero">
    <div class="inst-card__header inst-chart-card__header">
      <h2 class="inst-card__title">Earnings Trend (Last 30 days)</h2>
    </div>
    <div class="inst-card__body inst-chart-card__body">
      <% if @income_chart_data.values.sum > 0 %>
        <%= area_chart @income_chart_data,
            prefix: "",
            thousands: ",",
            colors: ["#4f46e5"],
            height: "260px",
            points: false,
            curve: true,
            empty: "No earnings in the last 30 days",
            round: 0,
            library: instructor_line_chart_library,
            messages: { empty: "No data available" } %>
      <% else %>
        <div class="inst-empty inst-chart-empty">
          <i class="bi bi-graph-up"></i>
          <p>No earnings data available</p>
        </div>
      <% end %>
    </div>
  </div>

  <%# Transaction History %>
  <div class="inst-card">
    <div class="inst-card__header">
      <h2 class="inst-card__title">Transaction History</h2>
    </div>
    <div class="data-table__wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th style="width: 120px;">ID</th>
            <th>Type</th>
            <th>Amount</th>
            <th>Details</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% if @transactions.any? %>
            <% @transactions.each do |txn| %>
              <tr>
                <td>
                  <code style="font-size: 0.75rem; color: #94a3b8;">#<%= txn.id %></code>
                </td>
                <td>
                  <% case txn.transaction_type %>
                  <% when 'sale_commission' %>
                    <span class="badge badge--success">
                      <i class="bi bi-graph-up-arrow"></i>
                      Commission
                    </span>
                  <% when 'withdrawal' %>
                    <span class="badge badge--danger">
                      <i class="bi bi-arrow-down"></i>
                      Withdrawal
                    </span>
                  <% else %>
                    <span class="badge badge--secondary"><%= txn.transaction_type %></span>
                  <% end %>
                </td>
                <td>
                  <span class="revenue-amount <%= txn.amount >= 0 ? 'revenue-amount--positive' : 'revenue-amount--negative' %>">
                    <%= txn.amount >= 0 ? "+" : "" %><%= format_vnd(txn.amount) %>
                  </span>
                </td>
                <td>
                  <% if txn.source_type == 'Enrollment' && txn.source %>
                    <span style="font-size: 0.85rem; color: #475569;">
                      <%= txn.source.course.title %>
                    </span>
                    <br>
                    <span style="font-size: 0.75rem; color: #94a3b8;">
                      Student: <%= txn.source.user.name %>
                    </span>
                  <% elsif txn.transaction_type == 'withdrawal' %>
                    <span style="font-size: 0.85rem; color: #475569;">Bank transfer</span>
                  <% end %>
                </td>
                <td style="font-size: 0.82rem; color: #64748b;">
                  <%= txn.created_at.strftime("%d %b %Y, %H:%M") %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5">
                <div class="inst-empty">
                  <i class="bi bi-inbox"></i>
                  <p>No transactions yet.</p>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="data-table__footer">
        <span class="data-table__info">Showing <%= @pagy.items %> of <%= @pagy.count %> transactions</span>
        <div class="inst-pagination" style="margin: 0;">
          <%== pagy_nav(@pagy) %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%# Payout Modal %>
<div class="modal fade" id="payoutModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <%= form_with model: PayoutRequest.new, url: instructor_payouts_path, local: true do |f| %>
        <div class="modal-header">
          <h5 class="modal-title" style="font-weight: 700; color: #1e293b;">Withdraw Funds</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="inst-alert inst-alert--info" style="margin-bottom: 1.5rem;">
            <i class="bi bi-wallet2"></i>
            <div>
              <strong>Available balance:</strong>
              <%= format_vnd(@wallet.balance) %>
            </div>
          </div>

          <div class="inst-form__group">
            <%= f.label :amount, "Amount (VND)", class: "inst-form__label" %>
            <%= f.number_field :amount, class: "inst-form__input", min: 100000, step: 10000, required: true,
                placeholder: "Minimum 100,000 VND" %>
          </div>

          <hr style="margin: 1.5rem 0;">

          <h6 style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem;">Bank Information</h6>

          <div class="inst-form__group">
            <%= f.label :bank_name, "Bank Name", class: "inst-form__label" %>
            <%= f.text_field :bank_name, class: "inst-form__input", required: true,
                placeholder: "e.g. MB Bank, Vietcombank" %>
          </div>

          <div class="inst-form__group">
            <%= f.label :bank_account_num, "Account Number", class: "inst-form__label" %>
            <%= f.text_field :bank_account_num, class: "inst-form__input", required: true,
                placeholder: "Your bank account number" %>
          </div>

          <div class="inst-form__group">
            <%= f.label :bank_account_name, "Account Holder Name", class: "inst-form__label" %>
            <%= f.text_field :bank_account_name, class: "inst-form__input", required: true,
                placeholder: "Name as shown on account (no accents)" %>
          </div>
        </div>
        <div class="modal-footer" style="border-top: 1px solid #e2e8f0; padding: 1rem 1.5rem;">
          <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Submit Request", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
