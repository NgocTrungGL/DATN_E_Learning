<div class="inst-page">
  <div class="inst-breadcrumb">
    <a href="<%= instructor_courses_path %>">Courses</a>
    <i class="bi bi-chevron-right"></i>
    <span><%= truncate(@course.title, length: 30) %></span>
    <i class="bi bi-chevron-right"></i>
    <span>Edit</span>
  </div>
  <div class="inst-card">
    <div class="inst-card__header">
      <h2 class="inst-card__title">Edit Course</h2>
      <a href="<%= instructor_course_path(@course) %>" class="btn btn-outline btn-sm">
        <i class="bi bi-arrow-left"></i>
        Back to Course
      </a>
    </div>
    <div class="inst-card__body">
      <%= render "form" %>
    </div>
  </div>
</div>
