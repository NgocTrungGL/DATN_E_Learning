<div class="inst-page">
  <div class="inst-page__header">
    <div>
      <h1 class="inst-page__title">My Courses</h1>
      <p class="inst-page__subtitle">Manage and organize your course content</p>
    </div>
    <div class="inst-page__actions">
      <a href="<%= new_instructor_course_path %>" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        <span>New Course</span>
      </a>
    </div>
  </div>

  <% if @courses.any? %>
    <%# Course Grid %>
    <div class="courses-grid">
      <% @courses.each do |course| %>
        <div class="courses-grid__item">
          <div class="courses-grid__thumb-wrap">
            <img src="<%= course.thumbnail_url.presence || 'https://via.placeholder.com/400x225/f0f2f5/aaa?text=No+Image' %>"
                 alt="<%= course.title %>"
                 class="courses-grid__thumb">
            <span class="courses-grid__status courses-grid__status--<%= course.status %>">
              <%= course.status == 'published' ? 'Active' : course.status.titleize %>
            </span>
          </div>
          <div class="courses-grid__body">
            <span class="courses-grid__category"><%= course.category&.name || "Uncategorized" %></span>
            <h3 class="courses-grid__title"><%= course.title %></h3>
            <p class="courses-grid__desc"><%= truncate(strip_tags(course.description), length: 80) %></p>
          </div>
          <div class="courses-grid__stats">
            <span class="courses-grid__stat">
              <i class="bi bi-collection"></i>
              <%= course.course_modules.count %> modules
            </span>
            <span class="courses-grid__stat">
              <i class="bi bi-people"></i>
              <%= course.enrollments.count %> students
            </span>
            <span class="courses-grid__stat">
              <i class="bi bi-currency-dollar"></i>
              <%= course.price.zero? ? 'Free' : number_to_currency(course.price, unit: '', precision: 0) + ' VND' %>
            </span>
          </div>
          <div class="courses-grid__actions">
            <a href="<%= instructor_course_path(course) %>" class="btn btn-primary btn-sm">
              <i class="bi bi-gear"></i>
              Manage
            </a>
            <div class="courses-grid__dropdown">
              <button type="button" class="btn-icon" data-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-three-dots-vertical"></i>
              </button>
              <ul class="courses-grid__dropdown-menu">
                <li>
                  <a href="<%= instructor_course_builder_path(course) %>" class="courses-grid__dropdown-item">
                    <i class="bi bi-puzzle"></i>
                    Course Builder
                  </a>
                </li>
                <li>
                  <a href="<%= edit_instructor_course_path(course) %>" class="courses-grid__dropdown-item">
                    <i class="bi bi-pencil"></i>
                    Edit Info
                  </a>
                </li>
                <li>
                  <a href="<%= students_instructor_course_path(course) %>" class="courses-grid__dropdown-item">
                    <i class="bi bi-people"></i>
                    View Students
                  </a>
                </li>
                <li>
                  <a href="<%= course_path(course) %>" class="courses-grid__dropdown-item" target="_blank">
                    <i class="bi bi-box-arrow-up-right"></i>
                    Preview
                  </a>
                </li>
                <li class="courses-grid__dropdown-divider"></li>
                <li>
                  <%= button_to instructor_course_path(course), method: :delete,
                      class: "courses-grid__dropdown-item courses-grid__dropdown-item--danger",
                      data: { confirm: "Delete this course? This cannot be undone." } do %>
                    <i class="bi bi-trash"></i>
                    Delete
                  <% end %>
                </li>
              </ul>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="inst-pagination">
        <%== pagy_nav(@pagy) %>
      </div>
      <p class="courses-pagination-info">
        Showing <%= @pagy.items %> of <%= @pagy.count %> courses
      </p>
    <% end %>

  <% else %>
    <div class="inst-empty-state">
      <div class="inst-empty-state__icon">
        <i class="bi bi-book"></i>
      </div>
      <h2>No courses yet</h2>
      <p>Start sharing your knowledge by creating your first course.</p>
      <a href="<%= new_instructor_course_path %>" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        Create Your First Course
      </a>
    </div>
  <% end %>
</div>
