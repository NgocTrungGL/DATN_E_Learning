<div class="inst-page">
  <%# Breadcrumb %>
  <div class="inst-breadcrumb">
    <a href="<%= instructor_courses_path %>">Courses</a>
    <i class="bi bi-chevron-right"></i>
    <span><%= truncate(@course.title, length: 30) %></span>
  </div>

  <%# Page Header %>
  <div class="inst-page__header">
    <div>
      <h1 class="inst-page__title"><%= @course.title %></h1>
      <p class="inst-page__subtitle">
        <span class="badge badge--<%= @course.status %>"><%= @course.status.titleize %></span>
        <span class="inst-page__subtitle-sep">by</span>
        <%= @course.creator.name %>
      </p>
    </div>
    <div class="inst-page__actions">
      <a href="<%= course_path(@course) %>" class="btn btn-outline" target="_blank">
        <i class="bi bi-box-arrow-up-right"></i>
        Preview
      </a>
      <a href="<%= instructor_courses_path %>" class="btn btn-outline">
        <i class="bi bi-arrow-left"></i>
        Back
      </a>
    </div>
  </div>

  <div class="course-detail-grid">
    <%# Left: Course Info Card %>
    <div class="course-detail-grid__sidebar">
      <div class="course-detail-card">
        <div class="course-detail-card__thumb-wrap">
          <img src="<%= @course.thumbnail_url.presence || 'https://via.placeholder.com/400x225/f0f2f5/aaa?text=No+Image' %>"
               alt="<%= @course.title %>"
               class="course-detail-card__thumb">
        </div>

        <div class="course-detail-card__body">
          <div class="course-detail-card__info-row">
            <span class="course-detail-card__info-label">Category</span>
            <span class="course-detail-card__info-value"><%= @course.category&.name || "—" %></span>
          </div>
          <div class="course-detail-card__info-row">
            <span class="course-detail-card__info-label">Price</span>
            <span class="course-detail-card__info-value">
              <%= @course.price.zero? ? 'Free' : format_vnd(@course.price) %>
            </span>
          </div>
          <div class="course-detail-card__info-row">
            <span class="course-detail-card__info-label">Modules</span>
            <span class="course-detail-card__info-value"><%= @course.course_modules.count %></span>
          </div>
          <div class="course-detail-card__info-row">
            <span class="course-detail-card__info-label">Students</span>
            <span class="course-detail-card__info-value"><%= @course.enrollments.count %></span>
          </div>
          <div class="course-detail-card__info-row">
            <span class="course-detail-card__info-label">Discounts</span>
            <span class="course-detail-card__info-value">
              <%= @course.allow_admin_discounts ? 'Allowed' : 'Not allowed' %>
            </span>
          </div>
        </div>

        <%# Status Action Button %>
        <div class="course-detail-card__action">
          <% if @course.draft? || @course.rejected? %>
            <%= button_to submit_for_review_instructor_course_path(@course), method: :patch,
                class: "btn btn-primary",
                style: "width: 100%;",
                data: { confirm: "Are you ready to submit? You cannot edit until admin approves." } do %>
              <i class="bi bi-send"></i>
              Submit for Review
            <% end %>
          <% elsif @course.pending? %>
            <button class="btn" style="width: 100%; background: #e2e8f0; cursor: default;" disabled>
              <i class="bi bi-hourglass-split"></i>
              Pending Admin Review
            </button>
          <% elsif @course.published? %>
            <button class="btn btn-success" style="width: 100%;" disabled>
              <i class="bi bi-check-circle-fill"></i>
              Published
            </button>
          <% end %>
        </div>

        <%# Action Buttons %>
        <div class="course-detail-card__actions">
          <a href="<%= instructor_course_builder_path(@course) %>" class="btn btn-primary" style="flex: 1;">
            <i class="bi bi-puzzle"></i>
            Builder
          </a>
          <a href="<%= edit_instructor_course_path(@course) %>" class="btn btn-outline" style="flex: 1;">
            <i class="bi bi-pencil"></i>
            Edit Info
          </a>
        </div>
        <div class="course-detail-card__actions" style="margin-top: 0.5rem;">
          <a href="<%= students_instructor_course_path(@course) %>" class="btn btn-outline" style="flex: 1;">
            <i class="bi bi-people"></i>
            Students
          </a>
          <a href="<%= instructor_course_performance_path(@course) %>" class="btn btn-outline" style="flex: 1;">
            <i class="bi bi-star"></i>
            Reviews
          </a>
        </div>
      </div>
    </div>

    <%# Right: Course Content %>
    <div class="course-detail-grid__content">
      <%# Modules List %>
      <div class="inst-card">
        <div class="inst-card__header">
          <h2 class="inst-card__title">Course Content</h2>
          <div style="display: flex; gap: 0.5rem;">
            <a href="<%= instructor_course_builder_path(@course) %>" class="btn btn-sm btn-outline-primary">
              <i class="bi bi-puzzle"></i>
              Builder
            </a>
            <% unless @course.pending? %>
              <a href="<%= new_instructor_course_course_module_path(@course) %>" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg"></i>
                Add Module
              </a>
            <% end %>
          </div>
        </div>
        <div class="inst-card__body">
          <% if @course_modules.any? %>
            <div class="curriculum__list">
              <% @course_modules.each do |mod| %>
                <div class="curriculum-module">
                  <div class="curriculum-module__header">
                    <div class="curriculum-module__info">
                      <h3 class="curriculum-module__title"><%= mod.title %></h3>
                      <span class="curriculum-module__count">
                        <%= mod.lessons.count %> lessons
                      </span>
                    </div>
                    <% unless @course.pending? %>
                      <div class="curriculum-module__actions">
                        <a href="<%= edit_instructor_course_module_path(mod) %>" class="btn-icon btn-icon--sm">
                          <i class="bi bi-pencil"></i>
                        </a>
                        <%= button_to instructor_course_module_path(mod), method: :delete,
                            class: "btn-icon btn-icon--sm btn-icon--danger",
                            data: { confirm: "Delete this module and all its lessons?" } do %>
                          <i class="bi bi-trash"></i>
                        <% end %>
                      </div>
                    <% end %>
                  </div>

                  <div class="curriculum-module__lessons">
                    <% mod.lessons.order(:order_index).each do |lesson| %>
                      <div class="curriculum-lesson">
                        <div class="curriculum-lesson__icon">
                          <i class="bi <%= lesson.video? ? 'bi-play-circle-fill' : 'bi-file-text-fill' %>"></i>
                        </div>
                        <div class="curriculum-lesson__info">
                          <span class="curriculum-lesson__title"><%= lesson.title %></span>
                          <div class="curriculum-lesson__meta">
                            <% if lesson.video? %>
                              <span><i class="bi bi-play-btn"></i> Video</span>
                            <% else %>
                              <span><i class="bi bi-file-text"></i> Text</span>
                            <% end %>
                          </div>
                        </div>
                        <% unless @course.pending? %>
                          <div class="curriculum-lesson__actions">
                            <a href="<%= edit_instructor_lesson_path(lesson) %>" class="btn-icon btn-icon--sm">
                              <i class="bi bi-pencil"></i>
                            </a>
                            <%= button_to instructor_lesson_path(lesson), method: :delete,
                                class: "btn-icon btn-icon--sm btn-icon--danger",
                                data: { confirm: "Delete this lesson?" } do %>
                              <i class="bi bi-trash"></i>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    <% end %>

                    <% if mod.lessons.empty? %>
                      <div class="curriculum-lesson curriculum-lesson--empty">
                        <span>No lessons yet</span>
                      </div>
                    <% end %>

                    <% unless @course.pending? %>
                      <a href="<%= new_instructor_course_module_lesson_path(mod) %>" class="curriculum-lesson curriculum-lesson--add">
                        <i class="bi bi-plus"></i>
                        Add Lesson
                      </a>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="inst-empty-state">
              <div class="inst-empty-state__icon">
                <i class="bi bi-collection"></i>
              </div>
              <h2>No content yet</h2>
              <p>Add modules and lessons to build your course.</p>
              <% unless @course.pending? %>
                <a href="<%= new_instructor_course_course_module_path(@course) %>" class="btn btn-primary">
                  <i class="bi bi-plus-lg"></i>
                  Add First Module
                </a>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <%# Big Quizzes %>
      <% if @big_quizzes.any? %>
        <div class="inst-card" style="margin-top: 1.5rem;">
          <div class="inst-card__header">
            <h2 class="inst-card__title">
              <i class="bi bi-trophy" style="color: #d97706;"></i>
              Final Quizzes
            </h2>
          </div>
          <div class="inst-card__body">
            <% @big_quizzes.each do |quiz| %>
              <div class="quiz-item">
                <div class="quiz-item__icon">
                  <i class="bi bi-list-check"></i>
                </div>
                <div class="quiz-item__info">
                  <span class="quiz-item__title"><%= quiz.title %></span>
                  <div class="quiz-item__meta">
                    <span><i class="bi bi-puzzle"></i> <%= quiz.total_questions %> questions</span>
                    <span><i class="bi bi-clock"></i> <%= quiz.time_limit %> min</span>
                  </div>
                </div>
                <a href="<%= instructor_quiz_path(quiz) %>" class="btn btn-outline btn-sm">
                  <i class="bi bi-gear"></i>
                  Manage
                </a>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
