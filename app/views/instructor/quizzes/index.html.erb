<div class="inst-page">
  <div class="inst-page__header">
    <div>
      <h1 class="inst-page__title">Quizzes</h1>
      <p class="inst-page__subtitle">Manage your assessments</p>
    </div>
    <div class="inst-page__actions">
      <a href="<%= new_instructor_quiz_path %>" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        New Quiz
      </a>
    </div>
  </div>

  <% if @quizzes.any? %>
    <div class="inst-card">
      <div class="data-table__wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 30%;">Quiz</th>
              <th>Course / Lesson</th>
              <th style="text-align: center;">Config</th>
              <th style="text-align: center;">Mode</th>
              <th style="width: 120px; text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @quizzes.each do |quiz| %>
              <tr>
                <td>
                  <div class="quiz-cell">
                    <span class="quiz-cell__title"><%= quiz.title %></span>
                    <span class="quiz-cell__desc">
                      <%= truncate(quiz.description, length: 60) || "No description" %>
                    </span>
                  </div>
                </td>
                <td>
                  <% if quiz.course %>
                    <span class="quiz-cell__course"><%= quiz.course.title %></span>
                  <% end %>
                  <% if quiz.lesson %>
                    <span class="quiz-cell__lesson">
                      <i class="bi bi-play-circle"></i>
                      <%= quiz.lesson.title %>
                    </span>
                  <% else %>
                    <span style="color: #94a3b8; font-size: 0.82rem;">Course-wide</span>
                  <% end %>
                </td>
                <td style="text-align: center;">
                  <div class="quiz-cell__config">
                    <span><i class="bi bi-puzzle"></i> <%= quiz.total_questions %> Q</span>
                    <span><i class="bi bi-clock"></i> <%= quiz.time_limit.present? ? "#{quiz.time_limit}m" : "—" %></span>
                    <span><i class="bi bi-trophy"></i> <%= quiz.pass_score %>%</span>
                  </div>
                </td>
                <td style="text-align: center;">
                  <% if quiz.random_mode %>
                    <span class="badge badge--success">Random</span>
                  <% else %>
                    <span class="badge badge--secondary">Fixed</span>
                  <% end %>
                </td>
                <td>
                  <div class="data-table__cell-actions">
                    <a href="<%= edit_instructor_quiz_path(quiz) %>" class="btn-icon btn-icon--sm" title="Edit">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <%= button_to instructor_quiz_path(quiz), method: :delete,
                        class: "btn-icon btn-icon--sm btn-icon--danger",
                        title: "Delete",
                        data: { confirm: "Delete this quiz?" } do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="data-table__footer">
          <span class="data-table__info">Showing <%= @pagy.items %> of <%= @pagy.count %> quizzes</span>
          <div class="inst-pagination" style="margin: 0;">
            <%== pagy_nav(@pagy) %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="inst-empty-state">
      <div class="inst-empty-state__icon">
        <i class="bi bi-list-check"></i>
      </div>
      <h2>No quizzes yet</h2>
      <p>Create quizzes to assess student learning.</p>
      <a href="<%= new_instructor_quiz_path %>" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        Create Your First Quiz
      </a>
    </div>
  <% end %>
</div>
