<div class="inst-form">
  <%= form_with(model: [:instructor, quiz], local: true) do |f| %>
    <% if quiz.errors.any? %>
      <div class="inst-alert inst-alert--danger">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <ul style="margin: 0; padding-left: 1.25rem;">
          <% quiz.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="inst-form__two-col">
      <%# Left Column: Quiz Details %>
      <div class="inst-form__main">
        <div class="inst-form__section">
          <h3 class="inst-form__section-title">Quiz Information</h3>

          <div class="inst-form__group">
            <%= f.label :title, "Quiz Title", class: "inst-form__label" %>
            <%= f.text_field :title, class: "inst-form__input", required: true,
                placeholder: "e.g. Chapter 3 Assessment" %>
          </div>

          <div class="inst-form__group">
            <%= f.label :description, "Description / Instructions", class: "inst-form__label" %>
            <%= f.text_area :description, rows: 3, class: "inst-form__textarea",
                placeholder: "Instructions for students..." %>
          </div>

          <div class="inst-form__row">
            <div class="inst-form__group">
              <%= f.label :course_id, "Course", class: "inst-form__label" %>
              <%= f.collection_select :course_id, @courses, :id, :title,
                  { include_blank: "Select a course" }, class: "inst-form__select" %>
            </div>
            <div class="inst-form__group">
              <%= f.label :lesson_id, "Lesson (optional)", class: "inst-form__label" %>
              <%= f.collection_select :lesson_id, @lessons, :id, :title,
                  { include_blank: "Course-wide quiz" }, class: "inst-form__select" %>
            </div>
          </div>
        </div>
      </div>

      <%# Right Column: Quiz Config %>
      <div class="inst-form__sidebar">
        <div class="inst-form__section">
          <h3 class="inst-form__section-title">Quiz Configuration</h3>

          <div class="inst-form__group">
            <%= f.label :total_questions, "Total Questions", class: "inst-form__label" %>
            <div class="quiz-config-input">
              <%= f.number_field :total_questions, class: "inst-form__input", min: 1 %>
              <span class="quiz-config-input__suffix">questions</span>
            </div>
          </div>

          <div class="inst-form__group">
            <%= f.label :time_limit, "Time Limit", class: "inst-form__label" %>
            <div class="quiz-config-input">
              <%= f.number_field :time_limit, class: "inst-form__input",
                  placeholder: "No limit", min: 1 %>
              <span class="quiz-config-input__suffix">minutes</span>
            </div>
            <span class="inst-form__hint">Leave empty for no time limit.</span>
          </div>

          <div class="inst-form__group">
            <%= f.label :pass_score, "Pass Score", class: "inst-form__label" %>
            <div class="quiz-config-input">
              <%= f.number_field :pass_score, class: "inst-form__input",
                  value: quiz.pass_score || 70, min: 0, max: 100, step: 5 %>
              <span class="quiz-config-input__suffix">%</span>
            </div>
          </div>

          <div class="inst-form__checkbox-wrap">
            <label class="inst-form__checkbox">
              <%= f.check_box :random_mode, class: "inst-form__checkbox-input" %>
              <span class="inst-form__checkbox-box"></span>
              <span class="inst-form__checkbox-label">
                <strong>Random questions</strong>
                <small>System picks questions from your bank.</small>
              </span>
            </label>
          </div>
        </div>

        <div class="inst-form__actions">
          <%= f.submit "Save Quiz", class: "btn btn-primary", style: "width: 100%;" %>
          <a href="<%= instructor_quizzes_path %>" class="btn btn-outline" style="width: 100%;">
            Cancel
          </a>
        </div>
      </div>
    </div>
  <% end %>
</div>
