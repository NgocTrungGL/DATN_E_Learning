<div class="inst-page">
  <div class="inst-breadcrumb">
    <a href="<%= instructor_course_performance_index_path %>">Course Performance</a>
    <i class="bi bi-chevron-right"></i>
    <span><%= truncate(@course.title, length: 30) %></span>
  </div>

  <div class="inst-page__header">
    <div>
      <h1 class="inst-page__title"><%= @course.title %></h1>
      <p class="inst-page__subtitle">Performance breakdown</p>
    </div>
    <a href="<%= instructor_course_performance_index_path %>" class="btn btn-outline">
      <i class="bi bi-arrow-left"></i>
      Back
    </a>
  </div>

  <%# Revenue + Enrollment Charts %>
  <div class="perf-charts-grid">
    <div class="inst-card">
      <div class="inst-card__header">
        <h2 class="inst-card__title">Revenue Trend (6 months)</h2>
        <span class="inst-card__subtitle">70% of enrollment price</span>
      </div>
      <div class="inst-card__body">
        <% if @monthly_revenue.values.sum > 0 %>
          <%= column_chart @monthly_revenue,
              height: "220px",
              colors: ["#10b981"],
              messages: { empty: "No revenue yet" } %>
        <% else %>
          <div class="inst-empty" style="padding: 2rem; text-align: center; color: #94a3b8;">
            <i class="bi bi-graph-up" style="font-size: 2rem;"></i>
            <p style="margin-top: 0.5rem;">No revenue yet</p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="inst-card">
      <div class="inst-card__header">
        <h2 class="inst-card__title">Enrollment vs Completion</h2>
        <span class="inst-card__subtitle">How many finish the course</span>
      </div>
      <div class="inst-card__body">
        <% if @enrollment_vs_completion.values.sum > 0 %>
          <%= bar_chart @enrollment_vs_completion,
              height: "220px",
              colors: ["#2563eb", "#10b981"],
              messages: { empty: "No data" } %>
        <% else %>
          <div class="inst-empty" style="padding: 2rem; text-align: center; color: #94a3b8;">
            <i class="bi bi-bar-chart" style="font-size: 2rem;"></i>
            <p style="margin-top: 0.5rem;">No data yet</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Rating Distribution %>
  <div class="inst-card" style="margin-top: 1.5rem;">
    <div class="inst-card__header">
      <h2 class="inst-card__title">Rating Distribution</h2>
      <span class="inst-card__subtitle">
        <% avg = @course.reviews.average(:rating).to_f.round(1) %>
        <% if avg > 0 %>
          <i class="bi bi-star-fill" style="color: #f59e0b;"></i>
          <strong><%= avg %></strong> / 5 from <%= @course.reviews.count %> reviews
        <% else %>
          No reviews yet
        <% end %>
      </span>
    </div>
    <div class="inst-card__body">
      <% if @rating_distribution.any? %>
        <% (1..5).reverse_each do |star| %>
          <% count = @rating_distribution[star] || 0 %>
          <% pct = @course.reviews.count > 0 ? (count.to_f / @course.reviews.count * 100) : 0 %>
          <div class="rating-row">
            <span class="rating-row__label"><%= star %> <i class="bi bi-star-fill" style="color: #f59e0b; font-size: 0.7rem;"></i></span>
            <div class="rating-row__bar">
              <div class="rating-row__fill" style="width: <%= pct %>%;"></div>
            </div>
            <span class="rating-row__count"><%= count %></span>
          </div>
        <% end %>
      <% else %>
        <div class="inst-empty" style="padding: 2rem; text-align: center; color: #94a3b8;">
          <i class="bi bi-star" style="font-size: 2rem;"></i>
          <p style="margin-top: 0.5rem;">No ratings yet</p>
        </div>
      <% end %>
    </div>
  </div>

  <%# Top Reviews %>
  <div class="inst-card" style="margin-top: 1.5rem;">
    <div class="inst-card__header">
      <h2 class="inst-card__title">Recent Reviews</h2>
    </div>
    <div class="data-table__wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th>Student</th>
            <th>Rating</th>
            <th>Comment</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% @course.reviews.order(created_at: :desc).limit(10).each do |review| %>
            <tr>
              <td>
                <div class="data-table__cell-user">
                  <div class="data-table__cell-user-avatar">
                    <%= review.user.name[0].upcase %>
                  </div>
                  <div class="data-table__cell-user-info">
                    <span class="data-table__cell-user-name"><%= review.user.name %></span>
                    <span class="data-table__cell-user-email"><%= review.user.email %></span>
                  </div>
                </div>
              </td>
              <td>
                <span style="color: #f59e0b;">
                  <% review.rating.times { %> <i class="bi bi-star-fill"></i> <% } %>
                  <% (5 - review.rating).times { %> <i class="bi bi-star" style="opacity: 0.3;"></i> <% } %>
                </span>
              </td>
              <td style="max-width: 300px;">
                <span style="font-size: 0.85rem; color: #64748b;">
                  <%= truncate(review.content, length: 80) %>
                </span>
              </td>
              <td style="color: #64748b; font-size: 0.82rem; white-space: nowrap;">
                <%= review.created_at.strftime("%d %b %Y") %>
              </td>
            </tr>
          <% end %>
          <% if @course.reviews.empty? %>
            <tr>
              <td colspan="4">
                <div class="inst-empty" style="padding: 2rem; text-align: center;">
                  <i class="bi bi-chat-left-text" style="font-size: 2rem;"></i>
                  <p style="margin-top: 0.5rem; color: #94a3b8;">No reviews yet</p>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
