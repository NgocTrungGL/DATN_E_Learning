<%= turbo_frame_tag note do %>
  <article class="lesson-tabs__note-card" id="note-<%= note.id %>">

    <div class="lesson-tabs__note-card-view">
      <div class="lesson-tabs__note-card-topbar">
        <span class="lesson-tabs__note-card-date">
          <i class="bi bi-clock"></i>
          <%= time_ago_in_words(note.updated_at) %> ago
        </span>
        <div class="lesson-tabs__note-card-actions">
          <button class="lesson-tabs__note-card-btn lesson-tabs__note-card-btn--edit"
                  type="button"
                  aria-label="Edit note"
                  onclick="this.closest('.lesson-tabs__note-card').querySelector('.lesson-tabs__note-card-view').hidden = true;
                           this.closest('.lesson-tabs__note-card').querySelector('.lesson-tabs__note-card-edit').hidden = false;">
            <i class="bi bi-pencil"></i>
          </button>
          <%= button_to note_path(note), method: :delete,
                class: "lesson-tabs__note-card-btn lesson-tabs__note-card-btn--delete",
                data: { turbo_confirm: "Delete this note?" },
                aria_label: "Delete note" do %>
            <i class="bi bi-trash"></i>
          <% end %>
        </div>
      </div>

      <div class="lesson-tabs__note-card-content">
        <p class="lesson-tabs__note-card-text"><%= simple_format(note.content) %></p>
      </div>
    </div>

    <div class="lesson-tabs__note-card-edit" hidden>
      <div class="lesson-tabs__note-card-edit-header">
        <span class="lesson-tabs__note-card-edit-label">
          <i class="bi bi-pencil-square"></i>
          Editing note
        </span>
      </div>
      <%= form_with model: note, url: note_path(note), method: :patch,
            class: "lesson-tabs__note-card-edit-form" do |f| %>
        <%= f.text_area :content, rows: 4, class: "lesson-tabs__note-card-textarea",
            placeholder: "Update your note..." %>
        <div class="lesson-tabs__note-card-edit-actions">
          <button type="button" class="lesson-tabs__note-card-cancel-btn"
                  onclick="this.closest('.lesson-tabs__note-card').querySelector('.lesson-tabs__note-card-view').hidden = false;
                           this.closest('.lesson-tabs__note-card').querySelector('.lesson-tabs__note-card-edit').hidden = true;">
            Cancel
          </button>
          <%= f.submit "Save changes", class: "lesson-tabs__note-card-save-btn" %>
        </div>
      <% end %>
    </div>

  </article>
<% end %>
