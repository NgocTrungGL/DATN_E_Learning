<div class="lesson-tabs__note-form" id="note-form">
  <div class="lesson-tabs__note-form-header">
    <div class="lesson-tabs__note-form-icon" aria-hidden="true">
      <i class="bi bi-feather"></i>
    </div>
    <div class="lesson-tabs__note-form-header-text">
      <h3 class="lesson-tabs__note-form-title">Take a note</h3>
      <p class="lesson-tabs__note-form-subtitle">Capture key points from this lesson</p>
    </div>
  </div>

  <%= form_with model: note, url: lesson_notes_path(lesson), class: "lesson-tabs__note-form-body" do |f| %>
    <div class="lesson-tabs__note-form-field">
      <%= f.text_area :content, rows: 4,
          placeholder: "What did you learn? Write down your thoughts, questions, or key takeaways...",
          class: "lesson-tabs__note-form-textarea",
          id: "note-textarea",
          required: true %>
      <% if note.errors[:content].any? %>
        <span class="lesson-tabs__note-form-error">
          <i class="bi bi-exclamation-circle"></i>
          <%= note.errors[:content].first %>
        </span>
      <% end %>
    </div>
    <div class="lesson-tabs__note-form-footer">
      <div class="lesson-tabs__note-form-hint">
        <i class="bi bi-lightbulb"></i>
        Notes are private — only you can see them
      </div>
      <button type="submit" class="lesson-tabs__note-form-submit">
        <i class="bi bi-bookmark-plus"></i>
        Save note
      </button>
    </div>
  <% end %>
</div>
