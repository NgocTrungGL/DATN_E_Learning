<%# ============================================================ %>
<%# SUBSCRIPTIONS INDEX — Pricing & Plan Management Page       %>
<%# ============================================================ %>
<% content_for :title, "Pricing Plans | E-Learning" %>
<% content_for :meta_description, "Choose the perfect plan to unlock all courses and advanced features." %>
<% content_for :full_width, true %>
<% content_for :body_class, "landing-page" %>

<%
  plans = [
    {
      key:         "free",
      name:        "Free",
      price_vnd:   0,
      description: "Start your journey with free access to selected courses.",
      badge:       nil,
      features: [
        { text: "Access to 20+ free courses",         ok: true  },
        { text: "Community forum access",             ok: true  },
        { text: "Official certificates",              ok: false },
        { text: "AI Study Assistant",                 ok: false },
        { text: "All courses under 1 million",        ok: false },
        { text: "Priority support",                   ok: false }
      ]
    },
    {
      key:         "pro",
      name:        "Pro",
      price_vnd:   499_000,
      description: "Everything you need to accelerate your learning journey.",
      badge:       "⭐ Most Popular",
      features: [
        { text: "Access to 20+ free courses",         ok: true  },
        { text: "All courses under 1 million",        ok: true  },
        { text: "AI Study Assistant",                 ok: true  },
        { text: "Community forum access",             ok: true  },
        { text: "Official certificates",              ok: true  },
        { text: "Priority support",                   ok: false }
      ]
    },
    {
      key:         "premium",
      name:        "Premium",
      price_vnd:   999_000,
      description: "Full access with personalized mentoring and all features.",
      badge:       nil,
      features: [
        { text: "Access to 20+ free courses",         ok: true  },
        { text: "ALL courses at any price",           ok: true  },
        { text: "AI Study Assistant",                 ok: true  },
        { text: "Community forum access",             ok: true  },
        { text: "Official certificates",              ok: true  },
        { text: "Priority support",                   ok: true  }
      ]
    }
  ]
  current_plan_details = plans.find { |plan| plan[:key] == @current_plan }
  has_paid_subscription = @current_subscription.present? && @current_plan != "free"
  can_upgrade_to_premium = @current_subscription&.pro? && @premium_upgrade_amount.to_i.positive?
%>

<div class="subscriptions-page">

  <%# ── Page Header ────────────────────────────────────────── %>
  <div class="subs-hero">
    <div class="subscriptions-page__inner">
      <div class="subscriptions-page__hero-content">
        <span class="subs-badge"><i class="bi bi-credit-card"></i> <%= has_paid_subscription ? "Subscription" : "Pricing Plans" %></span>
        <h1 class="subs-title"><%= has_paid_subscription ? "Manage Your Plan" : "Invest in Your Future" %></h1>
        <p class="subs-subtitle">
          <% if has_paid_subscription %>
            Track your billing cycle, access level, and renewal settings in one place.
          <% else %>
            Flexible plans for every stage of your journey. Start free, scale when you're ready.
          <% end %>
        </p>

        <%# Show current plan badge if logged in %>
        <% if current_user && @current_plan != "free" %>
          <div class="current-plan-notice">
            <i class="bi bi-patch-check-fill"></i>
            You are currently on the
            <strong><%= Subscription::PLAN_LABELS[@current_plan] %></strong> plan
            <% if @current_subscription&.current_period_end %>
              · Renews on <%= @current_subscription.current_period_end.strftime("%d/%m/%Y") %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# ── Active Subscription Manager ─────────────────────────── %>
  <div class="subscriptions-page__inner">
    <% if has_paid_subscription && current_plan_details %>
      <section class="subscription-manager" aria-labelledby="subscription-manager-title">
        <div class="subscription-manager__main">
          <div class="subscription-manager__header">
            <div class="subscription-manager__icon">
              <i class="bi bi-credit-card-2-front"></i>
            </div>
            <div>
              <div class="subscription-manager__eyebrow">
                <i class="bi bi-patch-check-fill"></i>
                Active subscription
              </div>
              <h2 id="subscription-manager-title" class="subscription-manager__title">
                <%= current_plan_details[:name] %> Plan
              </h2>
            </div>
          </div>

          <p class="subscription-manager__description">
            <%= current_plan_details[:description] %>
          </p>

          <div class="subscription-manager__stats">
            <div class="subscription-manager__stat">
              <span>Status</span>
              <strong><%= @current_subscription.status.humanize %></strong>
            </div>
            <div class="subscription-manager__stat">
              <span><%= @current_subscription.cancel_at_period_end? ? "Access ends" : "Next renewal" %></span>
              <strong>
                <%= @current_subscription.current_period_end&.strftime("%d/%m/%Y") || "Not available" %>
              </strong>
            </div>
            <div class="subscription-manager__stat">
              <span>Monthly price</span>
              <strong><%= number_to_currency(current_plan_details[:price_vnd], unit: "₫", format: "%n %u", precision: 0, delimiter: ".") %></strong>
            </div>
          </div>

          <ul class="subscription-manager__features">
            <% current_plan_details[:features].select { |feature| feature[:ok] }.each do |feature| %>
              <li>
                <i class="bi bi-check-circle-fill"></i>
                <%= feature[:text] %>
              </li>
            <% end %>
          </ul>
        </div>

        <aside class="subscription-manager__actions">
          <div class="subscription-manager__price-card">
            <span>Monthly billing</span>
            <strong><%= number_to_currency(current_plan_details[:price_vnd], unit: "₫", format: "%n %u", precision: 0, delimiter: ".") %></strong>
            <small>Auto-renews every month</small>
          </div>

          <% if @current_subscription.cancel_at_period_end? %>
            <div class="subscription-manager__notice subscription-manager__notice--warning">
              <i class="bi bi-clock-history"></i>
              Renewal is canceled. You keep access until the end of this billing period.
            </div>
            <% if @current_subscription.stripe_subscription_id.present? %>
              <%= button_to resume_subscription_path(@current_subscription),
                            method: :patch,
                            class: "subscription-manager__resume",
                            data: { turbo: false } do %>
                <i class="bi bi-arrow-repeat"></i> Resume renewal
              <% end %>
            <% end %>
          <% else %>
            <div class="subscription-manager__notice">
              <i class="bi bi-arrow-repeat"></i>
              Your plan renews automatically each month.
            </div>
            <% if @current_subscription.stripe_subscription_id.present? %>
              <%= button_to subscription_path(@current_subscription),
                             method: :delete,
                             class: "subscription-manager__cancel",
                             data: { confirm: "Cancel renewal for your #{current_plan_details[:name]} plan? You will retain access until the end of the current billing cycle." } do %>
                <i class="bi bi-x-circle"></i> Cancel renewal
              <% end %>
            <% end %>
          <% end %>

          <% if can_upgrade_to_premium %>
            <div class="subscription-manager__upgrade">
              <span>Upgrade today</span>
              <strong>
                <%= number_to_currency(@premium_upgrade_amount, unit: "₫", format: "%n %u", precision: 0, delimiter: ".") %>
              </strong>
              <small>Prorated for the time left in this billing period.</small>
              <%= button_to subscriptions_path,
                            method: :post,
                            params: { plan: "premium" },
                            class: "subscription-manager__upgrade-button",
                            data: { turbo: false } do %>
                <i class="bi bi-stars"></i> Upgrade to Premium
              <% end %>
            </div>
          <% end %>

          <%= link_to courses_path, class: "subscription-manager__browse" do %>
            <i class="bi bi-compass"></i>
            Browse included courses
          <% end %>
        </aside>
      </section>
    <% end %>

    <%# ── Pricing Grid ──────────────────────────────────────── %>
    <% if has_paid_subscription %>
      <div class="pricing-section-heading">
        <span>Plan comparison</span>
        <h2>Available plans</h2>
      </div>
    <% end %>

    <div class="pricing-grid">
      <% plans.each do |plan| %>
        <%
          is_active    = current_user && (@current_plan == plan[:key])
          is_popular   = plan[:badge].present?
          is_free      = plan[:key] == "free"
          is_upgrade    = has_paid_subscription && @current_plan == "pro" && plan[:key] == "premium" && @premium_upgrade_amount.to_i.positive?
        %>
        <div class="pricing-card <%= 'pricing-card--popular' if is_popular %> <%= 'pricing-card--active' if is_active %>"
             id="plan-<%= plan[:key] %>">

          <%# Popular badge %>
          <% if plan[:badge] %>
            <div class="pricing-card__badge"><%= plan[:badge] %></div>
          <% end %>

          <%# Active badge %>
          <% if is_active %>
            <div class="pricing-card__active-tag">
              <i class="bi bi-check-circle-fill"></i> Current Plan
            </div>
          <% end %>

          <div class="pricing-card__header">
            <div class="pricing-card__name"><%= plan[:name] %></div>
            <div class="pricing-card__price">
              <% if is_free %>
                <span class="pricing-card__amount">Free</span>
              <% else %>
                <span class="pricing-card__amount">
                  <%= number_to_currency(plan[:price_vnd], unit: "₫", format: "%n %u", precision: 0, delimiter: ".") %>
                </span>
                <span class="pricing-card__period">/ month</span>
              <% end %>
            </div>
            <p class="pricing-card__description"><%= plan[:description] %></p>
          </div>

          <ul class="pricing-card__features">
            <% plan[:features].each do |feature| %>
              <li class="<%= 'pricing-card__feature--disabled' unless feature[:ok] %>">
                <% if feature[:ok] %>
                  <i class="bi bi-check-circle-fill"></i>
                <% else %>
                  <i class="bi bi-x-circle"></i>
                <% end %>
                <%= feature[:text] %>
              </li>
            <% end %>
          </ul>

          <div class="pricing-card__cta">
            <% if is_active %>
              <%# Current plan - show cancel option for paid plans %>
              <button class="subscription-plan-button subscription-plan-button--current" disabled>
                <i class="bi bi-patch-check-fill"></i> Current Plan
              </button>
            <% elsif is_free %>
              <%# Free plan CTA %>
              <% if user_signed_in? %>
                <a href="<%= courses_path %>" class="subscription-plan-button subscription-plan-button--outline" id="free-plan-cta">
                  <i class="bi bi-compass"></i> Explore Courses
                </a>
              <% else %>
                <%= link_to new_user_registration_path, class: "subscription-plan-button subscription-plan-button--outline", id: "free-plan-register" do %>
                  <i class="bi bi-person-plus"></i> Get Started Free
                <% end %>
              <% end %>
            <% else %>
              <%# Paid plan CTA %>
              <% if is_upgrade %>
                <%= button_to subscriptions_path,
                               method: :post,
                               params: { plan: plan[:key] },
                               class: "subscription-plan-button subscription-plan-button--primary",
                               data: { turbo: false },
                               id: "upgrade-#{plan[:key]}" do %>
                  <i class="bi bi-stars"></i>
                  Upgrade for <%= number_to_currency(@premium_upgrade_amount, unit: "₫", format: "%n %u", precision: 0, delimiter: ".") %>
                <% end %>
              <% elsif has_paid_subscription %>
                <button class="subscription-plan-button subscription-plan-button--outline" disabled>
                  <i class="bi bi-lock-fill"></i>
                  Manage current plan
                </button>
              <% elsif user_signed_in? %>
                <%= button_to subscriptions_path,
                               method: :post,
                               params: { plan: plan[:key] },
                               class: "subscription-plan-button #{is_popular ? 'subscription-plan-button--primary' : 'subscription-plan-button--outline'}",
                               data: { turbo: false },
                               id: "subscribe-#{plan[:key]}" do %>
                  <i class="bi bi-lightning-charge-fill"></i>
                  <%= @current_plan == "free" ? "Start #{plan[:name]} Plan" : "Switch to #{plan[:name]}" %>
                <% end %>
              <% else %>
                <%= link_to new_user_session_path,
                            class: "subscription-plan-button #{is_popular ? 'subscription-plan-button--primary' : 'subscription-plan-button--outline'}",
                            id: "login-for-#{plan[:key]}" do %>
                  <i class="bi bi-box-arrow-in-right"></i> Login to Subscribe
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# ── Guarantee Strip ──────────────────────────────────── %>
    <div class="guarantee-strip">
      <div class="guarantee-item">
        <i class="bi bi-shield-check-fill"></i>
        <span>Secure checkout with Stripe</span>
      </div>
      <div class="guarantee-item">
        <i class="bi bi-arrow-counterclockwise"></i>
        <span>30-day money back guarantee</span>
      </div>
      <div class="guarantee-item">
        <i class="bi bi-credit-card"></i>
        <span>Cancel anytime</span>
      </div>
    </div>
  </div>

  <%# ── FAQ ─────────────────────────────────────────────────── %>
  <div class="subscriptions-page__inner">
    <div class="subs-faq">
      <h2 class="subs-faq__title">Frequently Asked Questions</h2>
      <div class="subs-faq__grid">

        <div class="subs-faq__item">
          <div class="subs-faq__q"><i class="bi bi-question-circle-fill"></i> Can I cancel anytime?</div>
          <p class="subs-faq__a">Yes! You can cancel your subscription at any time from your account settings. Your access will remain active until the end of the current billing period.</p>
        </div>

        <div class="subs-faq__item">
          <div class="subs-faq__q"><i class="bi bi-question-circle-fill"></i> What is the difference between Pro and Premium?</div>
          <p class="subs-faq__a">The Pro plan gives you access to all courses priced under 1 million VND. The Premium plan unlocks every single course on the platform and includes priority mentor support.</p>
        </div>

        <div class="subs-faq__item">
          <div class="subs-faq__q"><i class="bi bi-question-circle-fill"></i> Are certificates included in the subscription?</div>
          <p class="subs-faq__a">Yes, both Pro and Premium plans include official certificates of completion for every course you finish 100% and pass the required assessments.</p>
        </div>

        <div class="subs-faq__item">
          <div class="subs-faq__q"><i class="bi bi-question-circle-fill"></i> Can I upgrade from Pro to Premium?</div>
          <p class="subs-faq__a">Absolutely! You can upgrade to Premium at any time. The change will take effect immediately, and your billing will be adjusted accordingly.</p>
        </div>

      </div>
    </div>
  </div>

</div>
