<main class="b2b-register">
  <section class="b2b-register__shell">
    <aside class="b2b-register__intro" aria-label="Business learning overview">
      <%= link_to root_path, class: "b2b-register__brand" do %>
        <i class="bi bi-mortarboard-fill"></i>
        <span>E-Learning Business</span>
      <% end %>

      <div class="b2b-register__intro-copy">
        <span class="b2b-register__eyebrow">Business onboarding</span>
        <h1>Launch team training in one workspace</h1>
        <p>Create an organization account, assign licenses, and track employee progress from your business dashboard.</p>
      </div>

      <div class="b2b-register__benefits">
        <div class="b2b-register__benefit">
          <i class="bi bi-people-fill"></i>
          <span>Invite employees and manage access</span>
        </div>
        <div class="b2b-register__benefit">
          <i class="bi bi-bar-chart-line-fill"></i>
          <span>Monitor learning progress and reports</span>
        </div>
        <div class="b2b-register__benefit">
          <i class="bi bi-receipt-cutoff"></i>
          <span>Centralize purchases and invoices</span>
        </div>
      </div>
    </aside>

    <section class="b2b-register__form-panel" aria-label="Business registration form">
      <div class="b2b-register__form-header">
        <span class="b2b-register__step-label">Create account</span>
        <h2>Register your organization</h2>
        <p>Set up the company profile and the first business administrator.</p>
      </div>

      <%= form_with model: @organization, url: b2b_register_path, local: true, html: { class: "b2b-register-form" } do |f| %>
        <% if @organization.errors.any? %>
          <div class="b2b-register-alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
              <strong><%= pluralize(@organization.errors.count, "error") %> need fixing:</strong>
              <ul>
                <% @organization.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <div class="b2b-register-form__section">
          <div class="b2b-register-form__section-head">
            <span>1</span>
            <div>
              <h3>Organization information</h3>
              <p>This becomes the workspace your employees join.</p>
            </div>
          </div>

          <div class="b2b-register-form__grid">
            <div class="b2b-register-field">
              <%= f.label :name, "Organization name", class: "b2b-register-field__label" %>
              <%= f.text_field :name, class: "b2b-register-field__input", placeholder: "ZigEXn Corporation", required: true %>
            </div>

            <div class="b2b-register-field">
              <%= f.label :domain, "Website or domain", class: "b2b-register-field__label" %>
              <%= f.text_field :domain, class: "b2b-register-field__input", placeholder: "zigexn.vn", required: true %>
            </div>
          </div>
        </div>

        <div class="b2b-register-form__section">
          <div class="b2b-register-form__section-head">
            <span>2</span>
            <div>
              <h3>Administrator information</h3>
              <p>This user will manage licenses, employees, and reports.</p>
            </div>
          </div>

          <%= f.fields_for :users do |user_form| %>
            <div class="b2b-register-form__grid">
              <div class="b2b-register-field">
                <%= user_form.label :name, "Admin full name", class: "b2b-register-field__label" %>
                <%= user_form.text_field :name, class: "b2b-register-field__input", placeholder: "Minh Nguyen", required: true %>
              </div>

              <div class="b2b-register-field">
                <%= user_form.label :email, "Work email", class: "b2b-register-field__label" %>
                <%= user_form.email_field :email, class: "b2b-register-field__input", placeholder: "admin@company.com", required: true %>
              </div>

              <div class="b2b-register-field">
                <%= user_form.label :password, "Password", class: "b2b-register-field__label" %>
                <%= user_form.password_field :password, class: "b2b-register-field__input", placeholder: "Minimum 6 characters", required: true %>
              </div>

              <div class="b2b-register-field">
                <%= user_form.label :password_confirmation, "Confirm password", class: "b2b-register-field__label" %>
                <%= user_form.password_field :password_confirmation, class: "b2b-register-field__input", placeholder: "Re-enter password", required: true %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="b2b-register-form__actions">
          <%= f.button type: "submit", class: "b2b-register-submit" do %>
            <i class="bi bi-rocket-takeoff-fill"></i>
            Initialize workspace
          <% end %>
          <p>
            Already have an account?
            <%= link_to "Sign in", new_user_session_path %>
          </p>
        </div>
      <% end %>
    </section>
  </section>
</main>
