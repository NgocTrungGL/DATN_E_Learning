<main class="instructor-apply instructor-apply--status">
  <section class="instructor-status">
    <%= link_to root_path, class: "instructor-status__brand" do %>
      <i class="bi bi-mortarboard-fill"></i>
      <span>E-Learning Instructor</span>
    <% end %>

    <% if @profile.pending? %>
      <div class="instructor-status__icon instructor-status__icon--pending">
        <i class="bi bi-hourglass-split"></i>
      </div>
      <span class="instructor-status__eyebrow">Application submitted</span>
      <h1>Pending review</h1>
      <p>Your application has been submitted successfully. The admin team usually reviews instructor applications within 24 hours.</p>
    <% elsif @profile.approved? %>
      <div class="instructor-status__icon instructor-status__icon--approved">
        <i class="bi bi-check-circle-fill"></i>
      </div>
      <span class="instructor-status__eyebrow">Welcome aboard</span>
      <h1>Application approved</h1>
      <p>Congratulations, you are now an instructor. You can start building and managing your courses.</p>
      <%= link_to instructor_root_path, class: "instructor-status__cta" do %>
        <i class="bi bi-speedometer2"></i>
        Go to Instructor Dashboard
      <% end %>
    <% elsif @profile.rejected? %>
      <div class="instructor-status__icon instructor-status__icon--rejected">
        <i class="bi bi-x-circle-fill"></i>
      </div>
      <span class="instructor-status__eyebrow">Review complete</span>
      <h1>Application rejected</h1>
      <p>Your application was not approved. You can contact support if you need more details about the review.</p>
    <% end %>

    <%= link_to "Back to homepage", root_path, class: "instructor-status__link" %>
  </section>
</main>
