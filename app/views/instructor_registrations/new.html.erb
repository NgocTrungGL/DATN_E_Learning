<main class="instructor-apply">
  <section class="instructor-apply__shell">
    <aside class="instructor-apply__intro" aria-label="Instructor application overview">
      <%= link_to root_path, class: "instructor-apply__brand" do %>
        <i class="bi bi-mortarboard-fill"></i>
        <span>E-Learning Instructor</span>
      <% end %>

      <div class="instructor-apply__copy">
        <span class="instructor-apply__eyebrow">Instructor application</span>
        <h1>Build your teaching profile before publishing courses</h1>
        <p>
          Share your expertise, professional links, and payout details so the team can review your application and prepare your instructor profile.
        </p>
      </div>

      <div class="instructor-apply__checklist">
        <div class="instructor-apply__check">
          <i class="bi bi-person-video3"></i>
          <span>Teaching background for your public profile</span>
        </div>
        <div class="instructor-apply__check">
          <i class="bi bi-linkedin"></i>
          <span>Professional links for admin verification</span>
        </div>
        <div class="instructor-apply__check">
          <i class="bi bi-bank2"></i>
          <span>Payout details ready for future withdrawals</span>
        </div>
      </div>
    </aside>

    <section class="instructor-apply__panel" aria-label="Instructor application form">
      <div class="instructor-apply__header">
        <span>Start teaching</span>
        <h2>Apply to become an instructor</h2>
        <p>Complete the information below. Your application will be reviewed by the admin team.</p>
      </div>

      <%= form_with(model: @profile, url: instructor_registration_path, local: true, html: { class: "instructor-apply-form" }) do |f| %>
        <% if @profile.errors.any? %>
          <div class="instructor-apply-alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
              <strong><%= pluralize(@profile.errors.count, "error") %> need fixing:</strong>
              <ul>
                <% @profile.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <div class="instructor-apply-card">
          <div class="instructor-apply-card__header">
            <span>1</span>
            <div>
              <h3>Professional profile</h3>
              <p>This information helps learners understand your teaching background.</p>
            </div>
          </div>

          <div class="instructor-apply-card__body">
            <div class="instructor-apply-field instructor-apply-field--full">
              <%= f.label :bio_detailed, "Teaching experience", class: "instructor-apply-field__label" %>
              <%= f.text_area :bio_detailed,
                    rows: 6,
                    class: "instructor-apply-field__textarea",
                    required: true,
                    placeholder: "Tell us about your professional background, teaching experience, and topics you want to teach." %>
            </div>

            <div class="instructor-apply-form__grid">
              <div class="instructor-apply-field">
                <%= f.label :phone, "Phone number", class: "instructor-apply-field__label" %>
                <%= f.telephone_field :phone, class: "instructor-apply-field__input", required: true, placeholder: "+84..." %>
              </div>

              <div class="instructor-apply-field">
                <%= f.label :website_url, "Personal website", class: "instructor-apply-field__label" %>
                <%= f.url_field :website_url, class: "instructor-apply-field__input", placeholder: "https://your-portfolio.com" %>
              </div>
            </div>
          </div>
        </div>

        <div class="instructor-apply-card">
          <div class="instructor-apply-card__header">
            <span>2</span>
            <div>
              <h3>Verification links</h3>
              <p>Admin reviewers use these links to validate your expertise.</p>
            </div>
          </div>

          <div class="instructor-apply-card__body">
            <div class="instructor-apply-form__grid">
              <div class="instructor-apply-field">
                <%= f.label :linkedin_url, "LinkedIn profile", class: "instructor-apply-field__label" %>
                <%= f.url_field :linkedin_url, class: "instructor-apply-field__input", required: true, placeholder: "https://linkedin.com/in/..." %>
              </div>

              <div class="instructor-apply-field">
                <%= f.label :cv_url, "Public CV link", class: "instructor-apply-field__label" %>
                <%= f.url_field :cv_url, class: "instructor-apply-field__input", required: true, placeholder: "https://drive.google.com/..." %>
              </div>
            </div>

            <p class="instructor-apply-note">
              Please make sure your CV link is publicly accessible before submitting.
            </p>
          </div>
        </div>

        <div class="instructor-apply-card">
          <div class="instructor-apply-card__header">
            <span>3</span>
            <div>
              <h3>Payout information</h3>
              <p>These details can be used later when your instructor revenue is withdrawn.</p>
            </div>
          </div>

          <div class="instructor-apply-card__body">
            <div class="instructor-apply-form__grid">
              <div class="instructor-apply-field">
                <%= f.label :bank_name, "Bank name", class: "instructor-apply-field__label" %>
                <%= f.text_field :bank_name, class: "instructor-apply-field__input", placeholder: "Vietcombank" %>
              </div>

              <div class="instructor-apply-field">
                <%= f.label :bank_account_number, "Account number", class: "instructor-apply-field__label" %>
                <%= f.text_field :bank_account_number, class: "instructor-apply-field__input", placeholder: "0123456789" %>
              </div>

              <div class="instructor-apply-field instructor-apply-field--full">
                <%= f.label :bank_account_name, "Account holder name", class: "instructor-apply-field__label" %>
                <%= f.text_field :bank_account_name,
                      class: "instructor-apply-field__input",
                      placeholder: @profile.user&.name.to_s.upcase.presence || "NGUYEN VAN A" %>
              </div>
            </div>
          </div>
        </div>

        <div class="instructor-apply-form__actions">
          <%= f.button type: "submit", class: "instructor-apply-submit" do %>
            <i class="bi bi-send-check-fill"></i>
            Submit application
          <% end %>
          <%= link_to "Back to homepage", root_path, class: "instructor-apply-secondary-link" %>
        </div>
      <% end %>
    </section>
  </section>
</main>
