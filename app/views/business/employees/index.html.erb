<div class="business-page">
  <div class="business-page__header">
    <div>
      <h1 class="business-page__title">Employee List</h1>
      <p class="business-page__subtitle">Manage employees in your organization</p>
    </div>
    <div class="business-page__header-actions">
      <a href="<%= new_business_bulk_import_path %>" class="btn btn-outline-secondary">
        <i class="bi bi-upload"></i>
        Import CSV
      </a>
      <a href="<%= new_business_employee_path %>" class="btn btn-primary">
        <i class="bi bi-person-plus"></i>
        Add Employee
      </a>
    </div>
  </div>

  <div class="biz-card">
    <div class="data-table__wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th>Employee</th>
            <th>Email</th>
            <th>Joined</th>
            <th style="text-align: center;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @employees.any? %>
            <% @employees.each do |emp| %>
              <tr>
                <td>
                  <div class="data-table__cell-user">
                    <div class="data-table__cell-user-avatar">
                      <%= emp.name[0].upcase %>
                    </div>
                    <div class="data-table__cell-user-info">
                      <span class="data-table__cell-user-name"><%= emp.name %></span>
                    </div>
                  </div>
                </td>
                <td style="color: #475569; font-size: 0.875rem;"><%= emp.email %></td>
                <td style="color: #64748b; font-size: 0.82rem; white-space: nowrap;">
                  <%= emp.created_at.strftime("%d %b %Y") %>
                </td>
                <td style="text-align: center;">
                  <a href="<%= progress_business_employee_path(emp) %>"
                     target="_blank"
                     class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-bar-chart"></i>
                    Progress
                  </a>
                  <a href="<%= edit_business_employee_path(emp) %>"
                     class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <%= link_to business_employee_path(emp),
                             data: { turbo_method: :delete, turbo_confirm: "Delete this employee?" },
                             class: "btn btn-outline-danger btn-sm" do %>
                    <i class="bi bi-trash"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4">
                <div class="inst-empty" style="padding: 2.5rem; text-align: center;">
                  <i class="bi bi-people" style="font-size: 2.5rem;"></i>
                  <p style="margin-top: 0.75rem; color: #94a3b8;">No employees yet. Add your first employee!</p>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
