<div class="business-page">
  <div class="business-page__header">
    <div>
      <h1 class="business-page__title">Training Reports</h1>
      <p class="business-page__subtitle">Comprehensive analytics for your organization</p>
    </div>
  </div>

  <%# Overview Stats %>
  <div class="biz-section">
    <h2 class="biz-section__title">Overview</h2>
    <div class="biz-stats-grid biz-stats-grid--4">
      <div class="biz-stat-card">
        <div class="biz-stat-card__icon" style="background: rgba(14, 165, 233, 0.1); color: #0ea5e9;">
          <i class="bi bi-people"></i>
        </div>
        <div class="biz-stat-card__body">
          <span class="biz-stat-card__value"><%= @employees.count %></span>
          <span class="biz-stat-card__label">Total Employees</span>
        </div>
      </div>
      <div class="biz-stat-card">
        <div class="biz-stat-card__icon" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">
          <i class="bi bi-check-circle"></i>
        </div>
        <div class="biz-stat-card__body">
          <span class="biz-stat-card__value"><%= @compliance_rate %>%</span>
          <span class="biz-stat-card__label">Compliance Rate</span>
        </div>
      </div>
      <div class="biz-stat-card">
        <div class="biz-stat-card__icon" style="background: rgba(168, 85, 247, 0.1); color: #a855f7;">
          <i class="bi bi-trophy"></i>
        </div>
        <div class="biz-stat-card__body">
          <span class="biz-stat-card__value"><%= @avg_completion %>%</span>
          <span class="biz-stat-card__label">Avg Completion</span>
        </div>
      </div>
      <div class="biz-stat-card">
        <div class="biz-stat-card__icon" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
          <i class="bi bi-cash-coin"></i>
        </div>
        <div class="biz-stat-card__body">
          <span class="biz-stat-card__value"><%= format_vnd(@total_spent) %></span>
          <span class="biz-stat-card__label">Total Spent</span>
        </div>
      </div>
    </div>
  </div>

  <%# License Stats %>
  <div class="biz-section">
    <h2 class="biz-section__title">License Distribution</h2>
    <div class="biz-stats-grid biz-stats-grid--4">
      <div class="biz-stat-card">
        <div class="biz-stat-card__icon" style="background: rgba(100, 116, 139, 0.1); color: #64748b;">
          <i class="bi bi-collection"></i>
        </div>
        <div class="biz-stat-card__body">
          <span class="biz-stat-card__value"><%= @total_licenses %></span>
          <span class="biz-stat-card__label">Total Licenses</span>
        </div>
      </div>
      <div class="biz-stat-card">
        <div class="biz-stat-card__icon" style="background: rgba(14, 165, 233, 0.1); color: #0ea5e9;">
          <i class="bi bi-person-check"></i>
        </div>
        <div class="biz-stat-card__body">
          <span class="biz-stat-card__value"><%= @assigned_licenses %></span>
          <span class="biz-stat-card__label">Assigned</span>
        </div>
      </div>
      <div class="biz-stat-card">
        <div class="biz-stat-card__icon" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">
          <i class="bi bi-circle"></i>
        </div>
        <div class="biz-stat-card__body">
          <span class="biz-stat-card__value"><%= @available_licenses %></span>
          <span class="biz-stat-card__label">Available</span>
        </div>
      </div>
      <div class="biz-stat-card">
        <div class="biz-stat-card__icon" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
          <i class="bi bi-x-circle"></i>
        </div>
        <div class="biz-stat-card__body">
          <span class="biz-stat-card__value"><%= @expired_licenses %></span>
          <span class="biz-stat-card__label">Expired</span>
        </div>
      </div>
    </div>
  </div>

  <%# Course Performance %>
  <% if @course_stats.any? %>
    <div class="biz-section">
      <h2 class="biz-section__title">Course Performance</h2>
      <div class="biz-card">
        <div class="data-table__wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Course</th>
                <th style="text-align: center;">Total</th>
                <th style="text-align: center;">Assigned</th>
                <th style="text-align: center;">Completed</th>
                <th style="text-align: center;">Rate</th>
              </tr>
            </thead>
            <tbody>
              <% @course_stats.each do |stat| %>
                <tr>
                  <td>
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                      <div style="width: 40px; height: 24px; border-radius: 4px; overflow: hidden; background: #f1f5f9; flex-shrink: 0;">
                        <img src="<%= stat[:course].thumbnail_url.presence || 'https://via.placeholder.com/40x24/f1f5f9/aaa?text=No+Img' %>" alt="" style="width: 100%; height: 100%; object-fit: cover;">
                      </div>
                      <span style="font-weight: 600; font-size: 0.875rem; color: #0f172a;"><%= stat[:course].title %></span>
                    </div>
                  </td>
                  <td style="text-align: center;"><span class="badge badge--secondary"><%= stat[:total_licenses] %></span></td>
                  <td style="text-align: center;"><span class="badge badge--info"><%= stat[:assigned] %></span></td>
                  <td style="text-align: center;"><span class="badge badge--success"><%= stat[:completed] %></span></td>
                  <td style="text-align: center;">
                    <div style="display: flex; align-items: center; gap: 0.5rem; justify-content: center;">
                      <div style="width: 60px; height: 6px; background: #f1f5f9; border-radius: 3px; overflow: hidden;">
                        <div style="width: <%= stat[:completion_rate] %>%; height: 100%; background: linear-gradient(90deg, #22c55e, #4ade80); border-radius: 3px;"></div>
                      </div>
                      <span style="font-size: 0.8rem; font-weight: 600; color: #64748b;"><%= stat[:completion_rate] %>%</span>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <%# Top Employees %>
  <% if @top_employees.any? %>
    <div class="biz-section">
      <h2 class="biz-section__title">Top Performers</h2>
      <div class="biz-card">
        <div class="data-table__wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Employee</th>
                <th style="text-align: center;">Enrolled</th>
                <th style="text-align: center;">Completed</th>
                <th style="text-align: center;">Avg Score</th>
                <th style="text-align: center;">Progress</th>
                <th>Last Activity</th>
              </tr>
            </thead>
            <tbody>
              <% @top_employees.each do |emp| %>
                <tr>
                  <td>
                    <div class="data-table__cell-user">
                      <div class="data-table__cell-user-avatar"><%= emp[:employee].name[0].upcase %></div>
                      <div class="data-table__cell-user-info">
                        <span class="data-table__cell-user-name"><%= emp[:employee].name %></span>
                        <span class="data-table__cell-user-email"><%= emp[:employee].email %></span>
                      </div>
                    </div>
                  </td>
                  <td style="text-align: center; color: #64748b;"><%= emp[:enrolled] %></td>
                  <td style="text-align: center;"><span class="badge badge--success"><%= emp[:completed] %></span></td>
                  <td style="text-align: center;">
                    <span class="badge <%= emp[:avg_score] >= 70 ? 'badge--success' : 'badge--warning' %>">
                      <%= emp[:avg_score] > 0 ? "#{emp[:avg_score]}%" : "N/A" %>
                    </span>
                  </td>
                  <td style="text-align: center;">
                    <div style="display: flex; align-items: center; gap: 0.5rem; justify-content: center;">
                      <div style="width: 60px; height: 6px; background: #f1f5f9; border-radius: 3px; overflow: hidden;">
                        <div style="width: <%= emp[:progress] %>%; height: 100%; background: linear-gradient(90deg, #0ea5e9, #38bdf8); border-radius: 3px;"></div>
                      </div>
                      <span style="font-size: 0.8rem; font-weight: 600; color: #64748b;"><%= emp[:progress] %>%</span>
                    </div>
                  </td>
                  <td style="color: #64748b; font-size: 0.82rem;">
                    <%= emp[:last_activity] ? "#{time_ago_in_words(emp[:last_activity])} ago" : "N/A" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
</div>
