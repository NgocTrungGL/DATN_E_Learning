<div class="business-page">
  <div class="business-page__header">
    <div>
      <h1 class="business-page__title">Course Market</h1>
      <p class="business-page__subtitle">Purchase licenses for your organization's training program</p>
    </div>
  </div>

  <%# Search Bar %>
  <div class="cm-search-bar">
    <form method="get" action="<%= business_course_market_index_path %>" class="cm-search-form">
      <div class="cm-search-input-wrap">
        <i class="bi bi-search cm-search-icon"></i>
        <input type="text"
               name="search"
               value="<%= @search %>"
               placeholder="Search courses by name..."
               class="cm-search-input">
      </div>
      <button type="submit" class="cm-search-btn">
        Search
      </button>
      <% if @search %>
        <a href="<%= business_course_market_index_path %>" class="cm-search-clear">
          <i class="bi bi-x-lg"></i> Clear
        </a>
      <% end %>
    </form>
  </div>

  <% if @courses.any? %>
    <div class="cm-result-info">
      <% if @search %>
        <span><%= @pagy.count %> result(s) for "<strong><%= @search %></strong>"</span>
      <% else %>
        <span><%= @pagy.count %> courses available</span>
      <% end %>
    </div>

    <div class="cm-grid">
      <% @courses.each do |course| %>
        <div class="cm-card">
          <div class="cm-card__thumb">
            <% if course.image.attached? %>
              <img src="<%= url_for(course.image) %>" alt="<%= course.title %>">
            <% elsif course.thumbnail_url.present? %>
              <img src="<%= course.thumbnail_url %>" alt="<%= course.title %>">
            <% else %>
              <div class="cm-card__thumb-placeholder">
                <i class="bi bi-book"></i>
              </div>
            <% end %>
          </div>

          <div class="cm-card__body">
            <span class="cm-card__category"><%= course.category&.name || "Uncategorized" %></span>
            <h3 class="cm-card__title"><%= course.title %></h3>
            <p class="cm-card__desc"><%= course.description.to_s.truncate(100) %></p>

            <div class="cm-card__price-block">
              <span class="cm-card__price"><%= number_to_currency(course.price) %></span>
              <span class="cm-card__price-unit">/seat</span>
            </div>

            <div class="cm-card__offer">
              <i class="bi bi-tag-fill"></i>
              <div>
                <span class="cm-card__offer-title">Business offer:</span>
                Buy <strong>10 seats</strong> and get <strong>10%</strong> off.
                <br>
                <span class="cm-card__offer-price">
                  Now only <strong><%= number_to_currency(course.price * 0.9) %></strong>/seat
                </span>
              </div>
            </div>
          </div>

          <div class="cm-card__footer">
            <div class="cm-card__qty-row">
              <label class="cm-card__qty-label">Quantity</label>
              <a href="<%= new_business_purchase_path(course_id: course.id, quantity: 10) %>"
                 class="cm-card__buy-btn">
                <i class="bi bi-cart-plus"></i>
                Buy License
              </a>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="biz-card">
      <div class="inst-empty" style="padding: 3rem; text-align: center;">
        <i class="bi bi-search" style="font-size: 3rem;"></i>
        <p style="margin-top: 1rem; color: #94a3b8;">
        <% if @search %>
            No courses found for "<%= @search %>"
        <% else %>
            No courses available in the catalog right now.
        <% end %>
        </p>
        <% if @search %>
          <a href="<%= business_course_market_index_path %>" class="btn btn-outline-secondary" style="margin-top: 1rem;">
            Clear search
          </a>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @pagy.pages > 1 %>
    <div class="cm-pagination">
      <% if @pagy.page > 1 %>
        <a href="<%= business_course_market_index_path(page: @pagy.page - 1, search: @search) %>"
           class="cm-pagination__btn">Prev</a>
      <% end %>
      <span class="cm-pagination__info">Page <%= @pagy.page %> / <%= @pagy.pages %></span>
      <% if @pagy.page < @pagy.pages %>
        <a href="<%= business_course_market_index_path(page: @pagy.page + 1, search: @search) %>"
           class="cm-pagination__btn">Next</a>
      <% end %>
    </div>
  <% end %>
</div>
