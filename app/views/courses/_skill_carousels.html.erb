<%#
  SKILL CAROUSELS — Category-based exploration section
  Horizontal scrollable rows with scroll-snap, native swipe on mobile
  Uses random 4 subcategories from database
%>

<%
  # Get 4 random subcategories (already set in controller as @featured_subcategories)
  featured_cats = @featured_subcategories.to_a

  # Define icons for each category (fallback based on parent or index)
  cat_icons = {
    "Web Development" => "bi-code-slash",
    "Data Science" => "bi-bar-chart-fill",
    "UI/UX Design" => "bi-palette-fill",
    "Cloud & DevOps" => "bi-cloud-fill",
    "Mobile Development" => "bi-phone",
    "Database" => "bi-database-fill",
    "Security" => "bi-shield-fill",
    "Testing" => "bi-check-circle-fill",
    "Business" => "bi-briefcase-fill",
    "Marketing" => "bi-megaphone-fill",
  }
%>

<% if featured_cats.any? %>
<section class="skill-carousels" aria-label="Browse by Skill">
  <div class="skill-carousels__inner">

    <div class="skill-carousels__header">
      <div class="skill-carousels__eyebrow">Explore Skills</div>
      <h2 class="skill-carousels__title">Find Your Next Skill</h2>
      <p class="skill-carousels__subtitle">
        Browse curated courses by category — swipe on mobile, scroll on desktop.
      </p>
    </div>

    <%# Category tab pills %>
    <div class="skill-carousels__tabs" role="tablist" id="skill-tabs">
      <% featured_cats.each_with_index do |cat, idx| %>
        <button class="skill-carousels__tab <%= 'is-active' if idx == 0 %>"
                role="tab"
                data-target="skill-track-<%= idx %>"
                aria-selected="<%= idx == 0 ? 'true' : 'false' %>">
          <i class="bi <%= cat_icons[cat.name] || 'bi-folder-fill' %>"></i>
          <%= cat.name %>
        </button>
      <% end %>
    </div>

    <%# One scrollable track per category %>
    <% featured_cats.each_with_index do |cat, cat_idx| %>
      <div class="skill-carousels__panel <%= 'is-active' if cat_idx == 0 %>"
           id="skill-track-<%= cat_idx %>"
           role="tabpanel">

        <button class="skill-carousels__arrow skill-carousels__arrow--prev"
                aria-label="Scroll left"
                data-track="skill-track-<%= cat_idx %>">
          <i class="bi bi-chevron-left"></i>
        </button>

        <div class="skill-carousels__track" id="skill-inner-<%= cat_idx %>">
          <% courses = cat.courses.published.includes(:reviews).limit(5).to_a %>
          <% if courses.any? %>
            <% courses.each do |course| %>
              <%
                thumb = course.thumbnail_url.presence ||
                        "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=400&h=225&fit=crop"
                price_txt = course.free? ? "Free" :
                            number_to_currency(course.price, unit: "₫", format: "%n %u", precision: 0, delimiter: ".")
                reviews = course.reviews
                avg = reviews.any? ? reviews.average(:rating).to_f.round(1) : 0
              %>
              <article class="sc-card" data-href="<%= course_path(course) %>">
                <div class="sc-card__thumb">
                  <img src="<%= thumb %>" alt="<%= course.title %>" loading="lazy">
                </div>
                <div class="sc-card__body">
                  <p class="sc-card__title"><%= course.title.truncate(50) %></p>
                  <% if avg > 0 %>
                    <div class="sc-card__rating">
                      <span class="sc-card__score"><%= avg %></span>
                      <span class="sc-card__stars">
                        <% avg.floor.times do %><i class="bi bi-star-fill"></i><% end %>
                      </span>
                    </div>
                  <% end %>
                  <span class="sc-card__price"><%= price_txt %></span>
                </div>
              </article>
            <% end %>
          <% else %>
            <%# No courses in this category %>
            <div class="sc-empty">
              <i class="bi bi-inbox"></i>
              <p>No courses available in this category yet.</p>
              <a href="<%= courses_path %>" class="sc-empty__link">Browse all courses</a>
            </div>
          <% end %>
        </div>

        <button class="skill-carousels__arrow skill-carousels__arrow--next"
                aria-label="Scroll right"
                data-track="skill-inner-<%= cat_idx %>">
          <i class="bi bi-chevron-right"></i>
        </button>
      </div>
    <% end %>

  </div>
</section>
<% end %>
