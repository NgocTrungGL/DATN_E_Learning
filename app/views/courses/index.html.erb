<%# ============================================================ %>
<%# COURSES INDEX PAGE — No Bootstrap                           %>
<%# ============================================================ %>
<% content_for :full_width, true %>

<%# ── Dynamic Header (Flash Sale or Default Banner) ────────── %>
<% if @active_global_coupon && @sale_courses&.any? %>
  <%= render 'courses/flash_sales', coupon: @active_global_coupon, courses: @sale_courses %>
<% else %>
  <div class="courses-page-header">
    <div class="courses-inner">
      <div class="page-header-badge">📚 Course Catalog</div>
      <h1>Explore Our Courses</h1>
      <p class="header-subtitle">
        Browse <%= @courses.size %> expert-crafted courses and start building in-demand skills today.
      </p>
      <div class="header-stats">
        <div class="stat-item">
          <i class="bi bi-play-btn-fill stat-icon"></i>
          <strong><%= @courses.size %>+</strong> Courses Available
        </div>
        <div class="stat-item">
          <i class="bi bi-people-fill stat-icon"></i>
          <strong>10,000+</strong> Active Students
        </div>
        <div class="stat-item">
          <i class="bi bi-award-fill stat-icon"></i>
          <strong>Certificate</strong> on Completion
        </div>
      </div>
    </div>
  </div>
<% end %>

<%# ── Filter Bar ──────────────────────────────────────────── %>
<%#
  FUTURE BACKEND WIRING:
  - params[:query]       → Course.where("title ILIKE ?", "%#{params[:query]}%")
  - params[:category_id] → Course.where(category_id: params[:category_id])
  - params[:price_filter] → "free" → Course.where(price: 0); "paid" → where("price > 0")
  - params[:min_rating]  → join reviews + having avg >= min_rating
%>
<%
q = params[:q]
q_params = (q.respond_to?(:permit) ? q.permit!.to_h : (q.is_a?(Hash) ? q : {}))
%>
<turbo-frame id="courses-grid-container" target="_top">
<div class="courses-filter-bar" id="filter-bar">
  <div class="courses-inner">
    <div class="filter-form">
      <%# Search %>
      <div class="filter-search">
        <i class="bi bi-search search-icon"></i>
        <input
          type="search"
          id="filter-search-input"
          placeholder="Search courses..."
          autocomplete="off"
          value="<%= q_params[:title_cont] %>"
        >
        <% if q_params[:title_cont].present? %>
          <a href="<%= courses_path(params.permit(q: {}).to_h.merge(q: q_params.except(:title_cont).presence || {})) %>"
             class="search-clear-icon"
             title="Clear search">
            <i class="bi bi-x"></i>
          </a>
        <% end %>
      </div>

      <%# ── Category filter (2-level dropdowns) ── %>
      <% selected_cat_id = @q.category_id_eq || q_params[:category_id_eq] || q_params[:category_id] %>
      <% selected_cat = selected_cat_id.present? ? Category.find_by(id: selected_cat_id) : nil %>
      <% selected_parent = selected_cat&.parent_id.nil? ? selected_cat : (selected_cat ? selected_cat.parent : nil) %>
      <% selected_sub = selected_cat&.parent_id ? selected_cat : nil %>

      <div class="filter-category-wrapper" id="filter-category-wrapper">
        <select id="filter-parent-select" class="filter-select filter-select--category">
          <option value="">All Categories</option>
          <% @parent_categories.each do |parent| %>
            <option value="<%= parent.id %>" data-has-children="<%= parent.subcategories.any? %>"<%= " selected" if selected_parent&.id == parent.id %>>
              <%= parent.name %>
            </option>
          <% end %>
        </select>

        <select id="filter-sub-select" class="filter-select filter-select--category filter-select--sub" style="<%= selected_parent&.subcategories&.any? ? "" : "display:none" %>">
          <option value="">All Subcategories</option>
          <% if selected_parent&.subcategories&.any? %>
            <% selected_parent.subcategories.order(:name).each do |sub| %>
              <option value="<%= sub.id %>"<%= " selected" if selected_sub&.id == sub.id %>><%= sub.name %></option>
            <% end %>
          <% end %>
        </select>
      </div>

      <%# Price filter %>
      <select id="filter-price-select" class="filter-select">
        <option value="">Any Price</option>
        <option value="free"<%= " selected" if q_params[:price_filter] == "free" %>>Free</option>
        <option value="paid"<%= " selected" if q_params[:price_filter] == "paid" %>>Paid</option>
      </select>

      <%# Rating filter %>
      <select id="filter-rating-select" class="filter-select">
        <option value="">Any Rating</option>
        <option value="4.5"<%= " selected" if q_params[:min_rating_filter] == "4.5" %>>4.5+</option>
        <option value="4.0"<%= " selected" if q_params[:min_rating_filter] == "4.0" %>>4.0+</option>
        <option value="3.5"<%= " selected" if q_params[:min_rating_filter] == "3.5" %>>3.5+</option>
      </select>

      <div class="filter-actions">
        <a id="filter-apply-btn" href="#" class="filter-apply-btn">
          <i class="bi bi-funnel-fill"></i> Apply
        </a>
        <% if q_params.present? %>
          <%= link_to "Clear All", courses_path, class: "filter-clear-btn" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%# Flash Sale moved to header position %>

<%# ── Courses Grid ─────────────────────────────────────────── %>
<section class="courses-grid-section">
  <div class="courses-inner">
    <div class="results-meta mb-4">
      <span class="results-count" id="results-count-container">
        Showing <strong><%= pluralize(@courses_scope.count, 'course') %></strong>
      </span>
    </div>

    <% if @courses.any? %>
      <div class="courses-grid" id="courses-grid">
        <% @courses.each do |course| %>
          <%= render 'courses/course_card', course: course %>
        <% end %>
      </div>

      <turbo-frame id="courses-pagination">
        <div class="courses-pagination-wrapper">
          <% if @has_more %>
            <%= link_to courses_path(@current_filters.merge(page: @page + 1, format: :turbo_stream)), 
                  data: { turbo_frame: "courses-pagination" }, 
                  id: "see-more-button", 
                  class: "btn-see-more" do %>
              See More <i class="bi bi-chevron-down"></i>
            <% end %>
          <% end %>
        </div>
      </turbo-frame>

    <% else %>
      <div class="courses-empty">
        <div class="empty-icon">
          <i class="bi bi-search"></i>
        </div>
        <h3>No courses found</h3>
        <p>Try adjusting your search or filters to find what you're looking for.</p>
        <%= link_to "Clear Filters", courses_path, class: "btn-clear-filters" %>
      </div>
    <% end %>

    <%#
      PAGINATION — Uncomment ONE block below when ready:
      In controller: @courses = Course.page(params[:page]).per(12)  [kaminari]
                  OR @pagy, @courses = pagy(Course.all)              [pagy]
    %>
    <%# With kaminari: <div class="courses-pagination"><%= paginate @courses %></div>
    <%# With pagy:     <div class="courses-pagination"><%== pagy_nav(@pagy) %></div>

  </div>
</section>
</turbo-frame>

<%# ── Trending Bestsellers ─────────────────────────────────── %>
<%= render 'courses/trending_bestsellers' %>

<%# ── Skill Carousels ──────────────────────────────────────── %>
<%= render 'courses/skill_carousels' %>

<%# ── Learning Paths ───────────────────────────────────────── %>
<%= render 'courses/learning_paths' %>

<%# ── Global Footer ────────────────────────────────────────── %>
<%= render 'shared/landing_footer' %>

<%# ── Page-scoped JS (inline, Turbo-compatible) ─────────────── %>
<% content_for :page_js do %>
<script>
  document.addEventListener('turbo:load', function() {

    // ── Filter bar: URL-based navigation ──
    (function() {
      var applyBtn    = document.getElementById('filter-apply-btn');
      var searchInput = document.getElementById('filter-search-input');
      var parentSel   = document.getElementById('filter-parent-select');
      var subSel      = document.getElementById('filter-sub-select');
      var priceSel    = document.getElementById('filter-price-select');
      var ratingSel   = document.getElementById('filter-rating-select');

      if (!applyBtn) return;

      function buildUrl() {
        var parts = [];
        var search = searchInput && searchInput.value.trim();
        var parent = parentSel && parentSel.value;
        var sub    = subSel && subSel.value;
        var price  = priceSel && priceSel.value;
        var rating = ratingSel && ratingSel.value;

        if (search)              parts.push('q[title_cont]=' + encodeURIComponent(search));
        if (sub)                 parts.push('q[category_id_eq]=' + sub);
        else if (parent)         parts.push('q[category_id_eq]=' + parent);
        if (price)               parts.push('q[price_filter]=' + price);
        if (rating)             parts.push('q[min_rating_filter]=' + rating);

        return '/courses' + (parts.length ? '?' + parts.join('&') : '');
      }

      applyBtn.addEventListener('click', function(e) {
        e.preventDefault();
        var url = buildUrl() + '#filter-bar';
        window.location.href = url;
      });

      // After page load, scroll to filter bar if URL has hash
      if (window.location.hash === '#filter-bar') {
        var filterBar = document.getElementById('filter-bar');
        if (filterBar) {
          filterBar.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      // Enter key in search input triggers apply
      if (searchInput) {
        searchInput.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            applyBtn && applyBtn.click();
          }
        });
      }
    })();

    // ── Category cascading dropdown ──
    (function() {
      var parentSel = document.getElementById('filter-parent-select');
      var subSel    = document.getElementById('filter-sub-select');

      if (!parentSel || !subSel) return;

      parentSel.addEventListener('change', function() {
        var selected = parentSel.options[parentSel.selectedIndex];
        var hasChildren = selected && selected.dataset.hasChildren === 'true';
        var parentId = parentSel.value;

        subSel.innerHTML = '<option value="">All Subcategories</option>';
        subSel.value = '';

        if (!parentId) {
          subSel.style.display = 'none';
          return;
        }

        if (hasChildren) {
          fetch('/api/v1/categories/' + parentId + '/subcategories')
            .then(function(r) { return r.json(); })
            .then(function(data) {
              if (data.data && data.data.length > 0) {
                data.data.forEach(function(cat) {
                  var opt = document.createElement('option');
                  opt.value = cat.id;
                  opt.textContent = cat.name;
                  subSel.appendChild(opt);
                });
                subSel.style.display = 'block';
              } else {
                subSel.style.display = 'none';
              }
            })
            .catch(function() {
              subSel.style.display = 'none';
            });
        } else {
          subSel.style.display = 'none';
        }
      });
    })();

    // ── CountdownTimer (Dynamic Format: >24h ? D/H/M : H/M/S)
    (function() {
      var root  = document.getElementById('flash-countdown');
      if (!root) return;

      var endsAt = new Date(root.dataset.endsAt).getTime();
      var pad    = function(n){ return String(n).padStart(2, '0'); };

      function tick() {
        var diff = endsAt - Date.now();
        var units = root.querySelectorAll('.countdown__unit');
        
        if (diff <= 0) {
          units.forEach(u => u.querySelector('.countdown__num').textContent = '00');
          return;
        }

        var totalHours = Math.floor(diff / 3600000);
        
        if (totalHours >= 24) {
          // Format: DAYS : HRS : MIN
          var d = Math.floor(diff / (24 * 3600000));
          var h = Math.floor((diff % (24 * 3600000)) / 3600000);
          var m = Math.floor((diff % 3600000) / 60000);
          
          updateUnit(0, d, 'DAYS');
          updateUnit(1, h, 'HRS');
          updateUnit(2, m, 'MIN');
        } else {
          // Format: HRS : MIN : SEC
          var h = Math.floor(diff / 3600000);
          var m = Math.floor((diff % 3600000) / 60000);
          var s = Math.floor((diff % 60000) / 1000);
          
          updateUnit(0, h, 'HRS');
          updateUnit(1, m, 'MIN');
          updateUnit(2, s, 'SEC');
        }
      }

      function updateUnit(index, value, label) {
        var unit = root.querySelectorAll('.countdown__unit')[index];
        if (unit) {
          unit.querySelector('.countdown__num').textContent = pad(value);
          unit.querySelector('.countdown__label').textContent = label;
        }
      }

      tick();
      setInterval(tick, 1000);
    })();

    // ── TabController
    (function() {
      var tabsEl = document.getElementById('skill-tabs');
      if (!tabsEl) return;

      tabsEl.addEventListener('click', function(e) {
        var btn = e.target.closest('[data-target]');
        if (!btn) return;

        tabsEl.querySelectorAll('.skill-carousels__tab').forEach(function(t) {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        document.querySelectorAll('.skill-carousels__panel').forEach(function(p) {
          p.classList.remove('is-active');
        });

        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');
        var panel = document.getElementById(btn.dataset.target);
        if (panel) panel.classList.add('is-active');
      });
    })();

    // ── CarouselScroller
    (function() {
      document.querySelectorAll('.skill-carousels__arrow').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          var trackId = btn.dataset.track;
          var track   = document.getElementById(trackId);
          if (!track) return;
          var card    = track.querySelector('.sc-card');
          var amt     = ((card ? card.offsetWidth : 260) + 20) * 2;
          var isPrev  = btn.classList.contains('skill-carousels__arrow--prev');
          track.scrollBy({ left: isPrev ? -amt : amt, behavior: 'smooth' });
        });
      });
    })();

    // ── CardClickRouter (Event Delegation) — handles ALL course cards on page
    (function() {
      document.addEventListener('click', function(e) {
        const card = e.target.closest('[data-href]');
        if (!card) return;

        // Ignore clicks on actual links or buttons inside the card
        if (e.target.closest('a, button')) return;

        const href = card.dataset.href;
        if (href) {
          window.location.href = href;
        }
      });

      // Set role="link" for all cards with data-href
      document.querySelectorAll('[data-href]').forEach(el => {
        if (!el.hasAttribute('role')) {
          el.setAttribute('role', 'link');
        }
      });
    })();
  });
</script>
<% end %>
