<%
  results = local_assigns.fetch(:results, [])
  title = local_assigns.fetch(:title)
  kicker = local_assigns.fetch(:kicker)
  modifier = local_assigns[:modifier]
%>

<% if results.present? %>
  <section class="course-recommendations <%= "course-recommendations--#{modifier}" if modifier.present? %>">
    <div class="course-recommendations__header">
      <div>
        <p class="course-recommendations__kicker"><%= kicker %></p>
        <h2><%= title %></h2>
      </div>
      <%= link_to t("recommendations.browse_all"), courses_path, class: "course-recommendations__link" %>
    </div>

    <div class="course-recommendations__grid">
      <% results.each do |result| %>
        <%= render "courses/recommendation_card", result: result %>
      <% end %>
    </div>
  </section>
<% end %>
